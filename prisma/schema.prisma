// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Bảng lưu thông tin tài khoản người dùng đăng nhập toàn hệ thống
model User {
  /// ID định danh duy nhất
  id              Int        @id @default(autoincrement())
  /// Họ và tên đầy đủ
  fullName        String     @map("full_name") @db.VarChar(255)
  /// Địa chỉ email đăng nhập (duy nhất)
  email           String     @unique @db.VarChar(255)
  /// Số điện thoại liên hệ (duy nhất, có thể null nếu đăng ký qua email)
  phone           String?    @unique @db.VarChar(50)
  /// Mật khẩu đăng nhập đã mã hóa bcrypt
  passwordHash    String     @map("password_hash") @db.Text
  /// Quyền hệ thống toàn cục (ví dụ: SUPER_ADMIN). Nếu null thì chỉ là user bình thường hoặc user thuộc Tenant
  systemRole      String?    @map("system_role") @db.VarChar(50)
  /// Đường dẫn đến ảnh đại diện người dùng
  avatarUrl       String?    @map("avatar_url") @db.Text
  /// Mã OTP dùng để xác thực 2 yếu tố
  totpSecret      String?
  /// Trạng thái tài khoản người dùng
  status          UserStatus @default(ACTIVE)
  /// Thời điểm xác minh địa chỉ email
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  /// Thời điểm xác minh số điện thoại
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  /// Thời điểm đăng nhập hệ thống gần nhất
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  /// Thời điểm tạo tài khoản
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật tài khoản gần nhất
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm xóa tài khoản (hỗ trợ xóa mềm)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Các tổ chức/chủ trọ do người dùng này sở hữu chính
  ownedTenants              Tenant[]                 @relation("TenantOwner")
  /// Danh sách các tổ chức mà người dùng này làm thành viên hoặc nhân viên
  tenantMembers             TenantMember[]
  /// Hồ sơ chi tiết của người thuê (nếu tài khoản là khách thuê)
  renterProfile             RenterProfile?
  acceptedRenterInvitations RenterInvitation[]       @relation("AcceptedRenterInvitations")
  createdRenterInvitations  RenterInvitation[]       @relation("CreatedRenterInvitations")
  /// Lịch sử thuê phòng của người dùng này
  rentalHistories           RentalHistory[]
  /// Lịch sử xem phòng trên Marketplace của người dùng này
  roomViewLogs              RoomViewLog[]
  /// Danh sách các phòng trọ yêu thích của khách thuê
  favoriteRooms             FavoriteRoom[]
  /// Danh sách lịch hẹn xem phòng với tư cách khách thuê
  viewingAppointments       RoomViewingAppointment[] @relation("RenterAppointments")
  /// Danh sách lịch hẹn xem phòng được phân công hỗ trợ (với tư cách nhân viên)
  assignedAppointments      RoomViewingAppointment[] @relation("StaffAppointments")
  /// Danh sách các yêu cầu thuê phòng đã gửi
  rentalRequests            RentalRequest[]
  /// Các hợp đồng thuê phòng mà người dùng này là người ký chính
  contracts                 Contract[]
  /// Các hợp đồng thuê phòng mà người dùng này tham gia ở cùng (với tư cách thành viên)
  contractMembers           ContractMember[]
  /// Danh sách các tác vụ AI OCR do người dùng này tải lên
  uploadedOcrJobs           OcrJob[]                 @relation("UploadedJobs")
  /// Danh sách các hóa đơn của khách thuê này
  invoices                  Invoice[]                @relation("RenterInvoices")
  /// Danh sách các công nợ của khách thuê này
  renterDebts               Debt[]                   @relation("RenterDebts")
  /// Danh sách các thanh toán do khách thuê này thực hiện
  payments                  Payment[]                @relation("PayerPayments")
  /// Danh sách các thanh toán được người dùng này duyệt
  approvedPayments          Payment[]                @relation("PaymentApprover")
  /// Danh sách các thanh toán bị người dùng này từ chối
  rejectedPayments          Payment[]                @relation("PaymentRejecter")
  /// Danh sách các sự cố/ticket được phân công cho người dùng này xử lý
  assignedTickets           Ticket[]                 @relation("TicketAssignee")
  /// Danh sách các file đính kèm ticket do người dùng này tải lên
  ticketAttachments         TicketAttachment[]
  /// Danh sách các bình luận sự cố do người dùng này viết
  ticketComments            TicketComment[]
  /// Danh sách các phòng chat người dùng này tham gia
  conversationMembers       ConversationMember[]
  /// Danh sách tin nhắn người dùng này gửi
  sentMessages              Message[]                @relation("MessageSender")
  /// Danh sách các đánh giá do người dùng này thực hiện
  reviews                   Review[]                 @relation("Reviewer")
  /// Danh sách các đánh giá do người dùng này kiểm duyệt
  moderatedReviews          Review[]                 @relation("ReviewModerator")
  /// Danh sách các báo cáo vi phạm do người dùng này gửi
  reportedItems             Report[]                 @relation("Reporter")
  /// Danh sách các báo cáo vi phạm do người dùng này xử lý (với tư cách admin/staff)
  handledReports            Report[]                 @relation("ReportHandler")
  /// Danh sách các thông báo của người dùng này
  notifications             Notification[]
  /// Danh sách các mã token thiết bị của người dùng này
  deviceTokens              DeviceToken[]
  /// Danh sach refresh token dang hoac da duoc cap cho nguoi dung nay
  refreshTokens             RefreshToken[]
  /// Danh sach cac thiet bi dang nhap cua nguoi dung nay
  devices                   Device[]
  /// Danh sách các audit log do người dùng này thực hiện
  auditLogs                 AuditLog[]
  /// Lịch sử kiểm duyệt marketplace do người dùng này thực hiện
  marketplaceModerations    MarketplaceModeration[]

  // --- Audit Relations ---
  createdTenants                      Tenant[]                     @relation("TenantCreator")
  updatedTenants                      Tenant[]                     @relation("TenantUpdater")
  deletedTenants                      Tenant[]                     @relation("TenantDeleter")
  createdPropertys                    Property[]                   @relation("PropertyCreator")
  updatedPropertys                    Property[]                   @relation("PropertyUpdater")
  deletedPropertys                    Property[]                   @relation("PropertyDeleter")
  createdRooms                        Room[]                       @relation("RoomCreator")
  updatedRooms                        Room[]                       @relation("RoomUpdater")
  deletedRooms                        Room[]                       @relation("RoomDeleter")
  createdContracts                    Contract[]                   @relation("ContractCreator")
  updatedContracts                    Contract[]                   @relation("ContractUpdater")
  deletedContracts                    Contract[]                   @relation("ContractDeleter")
  createdInvoices                     Invoice[]                    @relation("InvoiceCreator")
  updatedInvoices                     Invoice[]                    @relation("InvoiceUpdater")
  deletedInvoices                     Invoice[]                    @relation("InvoiceDeleter")
  createdPayments                     Payment[]                    @relation("PaymentCreator")
  updatedPayments                     Payment[]                    @relation("PaymentUpdater")
  deletedPayments                     Payment[]                    @relation("PaymentDeleter")
  createdSubscriptionPayments         SubscriptionPayment[]        @relation("SubscriptionPaymentCreator")
  updatedSubscriptionPayments         SubscriptionPayment[]        @relation("SubscriptionPaymentUpdater")
  createdTickets                      Ticket[]                     @relation("TicketCreator")
  updatedTickets                      Ticket[]                     @relation("TicketUpdater")
  deletedTickets                      Ticket[]                     @relation("TicketDeleter")
  createdRoomAssets                   RoomAsset[]                  @relation("RoomAssetCreator")
  updatedRoomAssets                   RoomAsset[]                  @relation("RoomAssetUpdater")
  deletedRoomAssets                   RoomAsset[]                  @relation("RoomAssetDeleter")
  createdHandoverRecords              HandoverRecord[]             @relation("HandoverRecordCreator")
  updatedHandoverRecords              HandoverRecord[]             @relation("HandoverRecordUpdater")
  deletedHandoverRecords              HandoverRecord[]             @relation("HandoverRecordDeleter")
  createdMeterReadings                MeterReading[]               @relation("MeterReadingCreator")
  updatedMeterReadings                MeterReading[]               @relation("MeterReadingUpdater")
  deletedMeterReadings                MeterReading[]               @relation("MeterReadingDeleter")
  createdContractTemplates            ContractTemplate[]           @relation("ContractTemplateCreator")
  updatedContractTemplates            ContractTemplate[]           @relation("ContractTemplateUpdater")
  deletedContractTemplates            ContractTemplate[]           @relation("ContractTemplateDeleter")
  createdRoomViewingAppointments      RoomViewingAppointment[]     @relation("RoomViewingAppointmentCreator")
  updatedRoomViewingAppointments      RoomViewingAppointment[]     @relation("RoomViewingAppointmentUpdater")
  deletedRoomViewingAppointments      RoomViewingAppointment[]     @relation("RoomViewingAppointmentDeleter")
  createdRentalRequests               RentalRequest[]              @relation("RentalRequestCreator")
  updatedRentalRequests               RentalRequest[]              @relation("RentalRequestUpdater")
  deletedRentalRequests               RentalRequest[]              @relation("RentalRequestDeleter")
  createdInvoiceBatchs                InvoiceBatch[]               @relation("InvoiceBatchCreator")
  updatedInvoiceBatchs                InvoiceBatch[]               @relation("InvoiceBatchUpdater")
  deletedInvoiceBatchs                InvoiceBatch[]               @relation("InvoiceBatchDeleter")
  createdContractTerminationRequests  ContractTerminationRequest[] @relation("ContractTerminationRequestCreator")
  updatedContractTerminationRequests  ContractTerminationRequest[] @relation("ContractTerminationRequestUpdater")
  deletedContractTerminationRequests  ContractTerminationRequest[] @relation("ContractTerminationRequestDeleter")
  reviewedContractTerminationRequests ContractTerminationRequest[] @relation("ContractTerminationRequestReviewer")
  signedLandlordHandovers             HandoverRecord[]             @relation("HandoverLandlordSigner")
  signedRenterHandovers               HandoverRecord[]             @relation("HandoverRenterSigner")
  disputedHandovers                   HandoverRecord[]             @relation("HandoverDisputer")
  resolvedHandovers                   HandoverRecord[]             @relation("HandoverResolver")
  createdRoles                        Role[]                       @relation("RoleCreator")
  updatedRoles                        Role[]                       @relation("RoleUpdater")
  deletedRoles                        Role[]                       @relation("RoleDeleter")
  createdPermissions                  Permission[]                 @relation("PermissionCreator")
  updatedPermissions                  Permission[]                 @relation("PermissionUpdater")
  deletedPermissions                  Permission[]                 @relation("PermissionDeleter")
  createdPlans                        Plan[]                       @relation("PlanCreator")
  updatedPlans                        Plan[]                       @relation("PlanUpdater")
  deletedPlans                        Plan[]                       @relation("PlanDeleter")
  createdAmenitys                     Amenity[]                    @relation("AmenityCreator")
  updatedAmenitys                     Amenity[]                    @relation("AmenityUpdater")
  deletedAmenitys                     Amenity[]                    @relation("AmenityDeleter")
  createdAssetCategorys               AssetCategory[]              @relation("AssetCategoryCreator")
  updatedAssetCategorys               AssetCategory[]              @relation("AssetCategoryUpdater")
  deletedAssetCategorys               AssetCategory[]              @relation("AssetCategoryDeleter")

  @@index([email])
  @@index([status])
  @@map("users")
}

/// Bang luu refresh token theo thiet bi/phien dang nhap. Token chi luu dang hash.
model RefreshToken {
  /// ID dinh danh refresh token
  id            Int       @id @default(autoincrement())
  /// ID nguoi dung so huu refresh token
  userId        Int       @map("user_id")
  /// ID thiet bi tao refresh token (nullable de tuong thich voi token cu chua co device)
  deviceId      Int?      @map("device_id")
  /// Hash cua refresh token, khong luu plaintext token
  tokenHash     String    @unique @map("token_hash") @db.Text
  /// User-Agent cua thiet bi hoac trinh duyet dang nhap
  userAgent     String?   @map("user_agent") @db.Text
  /// IP tao phien dang nhap
  ip            String?   @db.VarChar(64)
  /// Thoi diem token het han
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  /// Thoi diem token bi thu hoi, null neu van con hieu luc
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  /// Ly do thu hoi token neu co
  revokedReason String?   @map("revoked_reason") @db.VarChar(255)
  /// Thoi diem tao token
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Thoi diem cap nhat token gan nhat
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// Nguoi dung so huu token
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Thiet bi tao token (xoa thiet bi thi thu hoi token tuong ung)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

/// Bang luu thong tin thiet bi dang nhap cua nguoi dung. Moi thiet bi dai dien cho mot trinh duyet/app tren mot may cu the.
model Device {
  /// ID dinh danh thiet bi
  id           Int      @id @default(autoincrement())
  /// ID nguoi dung so huu thiet bi
  userId       Int      @map("user_id")
  /// Chuoi User-Agent nhan dien trinh duyet/ung dung
  userAgent    String   @map("user_agent") @db.Text
  /// Dia chi IP khi dang nhap tu thiet bi nay
  ip           String   @db.VarChar(64)
  /// Thoi diem hoat dong gan nhat tren thiet bi
  lastActiveAt DateTime @updatedAt @map("last_active_at") @db.Timestamptz
  /// Thoi diem dang ky thiet bi (lan dang nhap dau tien tu thiet bi nay)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Trang thai thiet bi: true = dang dang nhap, false = da dang xuat
  isActive     Boolean  @default(true) @map("is_active")

  // Cac quan he (Relations)
  /// Nguoi dung so huu thiet bi (xoa nguoi dung thi cascade xoa thiet bi)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Danh sach refresh token duoc cap cho thiet bi nay
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([isActive])
  @@map("devices")
}

/// Bang luu ma xac thuc OTP theo email. Code chi luu dang hash.
model VerificationCode {
  /// ID dinh danh verification code
  id            Int                  @id @default(autoincrement())
  /// Email nhan ma xac thuc
  email         String               @db.VarChar(255)
  /// Hash cua OTP, khong luu plaintext code
  codeHash      String               @map("code_hash") @db.Text
  /// Ngu canh su dung ma xac thuc
  type          VerificationCodeType
  /// So lan xac thuc sai
  attempts      Int                  @default(0)
  /// Thoi diem ma het han
  expiresAt     DateTime             @map("expires_at") @db.Timestamptz
  /// Thoi diem ma da duoc dung thanh cong
  consumedAt    DateTime?            @map("consumed_at") @db.Timestamptz
  /// Thoi diem ma bi vo hieu hoa do cap ma moi hoac het hieu luc thu cong
  invalidatedAt DateTime?            @map("invalidated_at") @db.Timestamptz
  /// Thoi diem tao ma
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, type])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([invalidatedAt])
  @@map("verification_codes")
}

/// Bảng danh sách các vai trò (roles) trong hệ thống
model Role {
  /// ID định danh vai trò chính là mã vai trò (ví dụ: ADMIN, LANDLORD, STAFF, RENTER)
  id          String  @id @db.VarChar(50)
  /// Tên hiển thị của vai trò (ví dụ: Chủ trọ, Nhân viên)
  name        String  @db.VarChar(100)
  /// Mô tả chi tiết về chức năng của vai trò
  description String? @db.Text

  // Các quan hệ (Relations)
  /// Các quyền hạn được gán cho vai trò này
  permissions   RolePermission[]
  /// Các thành viên tenant được gán vai trò này
  tenantMembers TenantMember[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("RoleCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("RoleUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("RoleDeleter", fields: [deletedById], references: [id])

  @@map("roles")
}

/// Bảng danh sách các quyền chi tiết trong hệ thống
model Permission {
  /// ID định danh quyền
  id          Int     @id @default(autoincrement())
  /// Mã quyền duy nhất (ví dụ: ROOM_CREATE, INVOICE_VIEW)
  code        String  @unique @db.VarChar(100)
  /// Tên hiển thị quyền (ví dụ: Tạo phòng, Xem hóa đơn)
  name        String  @db.VarChar(100)
  /// Module hoặc nhóm chức năng áp dụng quyền này
  module      String  @db.VarChar(100)
  /// Mô tả chi tiết về quyền hạn
  description String? @db.Text

  // Các quan hệ (Relations)
  /// Các vai trò sở hữu quyền hạn này
  roles RolePermission[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("PermissionCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("PermissionUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("PermissionDeleter", fields: [deletedById], references: [id])

  @@map("permissions")
}

/// Bảng trung gian gán quyền cho vai trò (Role - Permission)
model RolePermission {
  /// ID của vai trò liên kết
  roleId       String @map("role_id") @db.VarChar(50)
  /// ID của quyền hạn liên kết
  permissionId Int    @map("permission_id")

  // Các quan hệ (Relations)
  /// Bản ghi vai trò tương ứng (xóa vai trò tự động xóa liên kết)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Bản ghi quyền tương ứng (xóa quyền tự động xóa liên kết)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Bảng đại diện cho từng chủ trọ / tổ chức kinh doanh phòng trọ (Tenant)
model Tenant {
  /// ID định danh tổ chức
  id                 Int                @id @default(autoincrement())
  /// ID của người dùng làm chủ sở hữu chính của Tenant
  ownerUserId        Int                @map("owner_user_id")
  /// Tên thương hiệu hoặc tên chủ trọ
  name               String             @db.VarChar(255)
  /// Chuỗi định danh URL (slug duy nhất) dùng để tạo URL riêng cho tenant
  slug               String             @unique @db.VarChar(255)
  /// Mã số thuế doanh nghiệp/hộ kinh doanh (nếu có)
  taxCode            String?            @map("tax_code") @db.VarChar(50)
  /// Số điện thoại liên hệ đại diện tenant
  phone              String?            @db.VarChar(50)
  /// Email liên hệ đại diện tenant
  email              String?            @db.VarChar(255)
  /// Địa chỉ trụ sở/văn phòng giao dịch
  address            String?            @db.Text
  /// Trạng thái xác thực thông tin tenant bởi Super Admin
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  /// Trạng thái hoạt động của tenant
  status             TenantStatus       @default(ACTIVE)
  /// Thời điểm đăng ký tenant trên hệ thống
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật thông tin tenant gần nhất
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm xóa tenant (hỗ trợ xóa mềm)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Người dùng sở hữu Tenant (chặn xóa người dùng nếu đang sở hữu tenant)
  owner                  User                         @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// Danh sách nhân viên hoặc thành viên trực thuộc tenant
  members                TenantMember[]
  /// Danh sách các đăng ký gói dịch vụ của tenant này
  subscriptions          Subscription[]
  /// Lịch sử các giao dịch thanh toán gói SaaS của tenant này
  subscriptionPayments   SubscriptionPayment[]
  /// Danh sách các bất động sản/nhà trọ thuộc tenant quản lý
  properties             Property[]
  /// Danh sách các tầng thuộc các nhà trọ trong tenant này
  floors                 Floor[]
  /// Danh sách các phòng trọ trực thuộc tenant quản lý
  rooms                  Room[]
  /// Lịch sử kiểm duyệt marketplace của tenant
  marketplaceModerations MarketplaceModeration[]
  /// Danh sách lịch sử thuê phòng xảy ra tại tenant này
  rentalHistories        RentalHistory[]
  /// Lịch hẹn xem phòng của tenant này
  viewingAppointments    RoomViewingAppointment[]
  /// Yêu cầu thuê phòng được gửi đến tenant này
  rentalRequests         RentalRequest[]
  renterInvitations      RenterInvitation[]
  /// Danh sách các mẫu hợp đồng do tenant định nghĩa
  contractTemplates      ContractTemplate[]
  /// Danh sách các hợp đồng thuê phòng thuộc tenant quản lý
  contracts              Contract[]
  serviceCatalogItems    ServiceCatalogItem[]
  serviceAssignments     ServiceAssignment[]
  /// Danh sách các yêu cầu trả phòng gửi đến tenant này
  terminationRequests    ContractTerminationRequest[]
  assetCategories        AssetCategory[]
  /// Danh sách tài sản thuộc quản lý của tenant
  roomAssets             RoomAsset[]
  /// Danh sách biên bản bàn giao thuộc tenant
  handoverRecords        HandoverRecord[]
  /// Danh sách đồng hồ điện nước thuộc tenant
  utilityMeters          UtilityMeter[]
  /// Danh sách các chỉ số điện nước đã ghi nhận của tenant
  meterReadings          MeterReading[]
  /// Danh sách các tác vụ AI OCR của tenant
  ocrJobs                OcrJob[]
  /// Danh sách các đợt hóa đơn hàng loạt của tenant
  invoiceBatches         InvoiceBatch[]
  /// Danh sách các hóa đơn của tenant
  invoices               Invoice[]
  /// Danh sách các khoản công nợ của tenant
  debts                  Debt[]
  /// Danh sách lịch sử thanh toán tiền phòng của khách thuê gửi tenant
  payments               Payment[]
  /// Danh sách mã QR thanh toán của tenant
  paymentQrCodes         PaymentQrCode[]
  /// Danh sách log webhook thanh toán của tenant
  paymentWebhookLogs     PaymentWebhookLog[]
  /// Danh sách các sự cố/ticket trong tenant này
  tickets                Ticket[]
  /// Danh sách các phòng chat trong tenant này
  conversations          Conversation[]
  /// Danh sách các đánh giá về các phòng/nhà thuộc tenant này
  reviews                Review[]
  /// Bảng điểm uy tín các đối tượng thuộc tenant này
  reputationScores       ReputationScore[]
  /// Danh sách thông báo liên quan đến tenant này
  notifications          Notification[]
  /// Danh sách tác vụ nền của tenant này
  backgroundJobs         BackgroundJob[]
  /// Danh sách audit log thao tác của tenant này
  auditLogs              AuditLog[]
  /// ID người dùng tạo bản ghi
  createdById            Int?                         @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById            Int?                         @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById            Int?                         @map("deleted_by_id")

  createdBy User? @relation("TenantCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("TenantUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("TenantDeleter", fields: [deletedById], references: [id])

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

/// Bảng quản lý nhân sự và phân quyền thành viên của từng Tenant
model TenantMember {
  /// ID định danh duy nhất
  id        Int                @id @default(autoincrement())
  /// ID của Tenant liên kết
  tenantId  Int                @map("tenant_id")
  /// ID của người dùng liên kết
  userId    Int                @map("user_id")
  /// ID của vai trò được giao trong Tenant này
  roleId    String             @map("role_id") @db.VarChar(50)
  /// Trạng thái làm việc của thành viên trong tenant
  status    TenantMemberStatus @default(INVITED)
  /// Thời điểm chính thức tham gia vào Tenant (khi xác nhận lời mời)
  joinedAt  DateTime?          @map("joined_at") @db.Timestamptz
  /// Thời điểm gửi lời mời hoặc tạo bản ghi thành viên
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant liên kết (khi xóa tenant thì tự động xóa các thành viên của nó)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Người dùng liên kết (khi xóa người dùng thì tự động xóa liên kết thành viên)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Vai trò liên kết (chặn xóa vai trò nếu đang có thành viên được gán vai trò này)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

/// Bảng lưu trữ các gói dịch vụ SaaS hệ thống cung cấp cho chủ trọ
model Plan {
  /// ID gói dịch vụ
  id                  Int      @id @default(autoincrement())
  /// Mã gói cước duy nhất (ví dụ: FREE, PRO, BUSINESS)
  code                String   @unique @db.VarChar(50)
  /// Tên gói dịch vụ
  name                String   @db.VarChar(100)
  /// Mô tả chi tiết các quyền lợi của gói
  description         String?  @db.Text
  /// Giá thuê gói theo tháng
  priceMonthly        Decimal  @map("price_monthly") @db.Decimal(12, 2)
  /// Giá thuê gói theo năm
  priceYearly         Decimal  @map("price_yearly") @db.Decimal(12, 2)
  /// Số lượng phòng tối đa được phép tạo và quản lý
  maxRooms            Int      @map("max_rooms")
  /// Số lượng nhân sự/thành viên tối đa được thêm vào tenant
  maxStaff            Int      @map("max_staff")
  /// Cho phép sử dụng tính năng nhận diện chỉ số điện nước qua AI OCR
  allowAiOcr          Boolean  @default(false) @map("allow_ai_ocr")
  /// Cho phép cấu hình Webhook tự động ghi nhận thanh toán ngân hàng
  allowWebhookPayment Boolean  @default(false) @map("allow_webhook_payment")
  /// Trạng thái gói cước có đang mở bán hay không
  isActive            Boolean  @default(true) @map("is_active")
  /// Số lượng nhà trọ tối đa được phép tạo và quản lý
  maxProperties       Int      @default(0) @map("max_properties")
  /// Thời điểm tạo gói cước
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Danh sách các đăng ký của các tenant sử dụng gói dịch vụ này
  subscriptions Subscription[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("PlanCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("PlanUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("PlanDeleter", fields: [deletedById], references: [id])

  @@map("plans")
}

/// Bảng lưu thông tin các gói đăng ký dịch vụ hiện tại và lịch sử của từng Tenant
model Subscription {
  /// ID bản ghi đăng ký
  id           Int                @id @default(autoincrement())
  /// ID của Tenant đăng ký
  tenantId     Int                @map("tenant_id")
  /// ID của gói dịch vụ sử dụng
  planId       Int                @map("plan_id")
  /// Trạng thái hiện tại của gói đăng ký
  status       SubscriptionStatus @default(ACTIVE)
  /// Thời điểm bắt đầu chu kỳ đăng ký
  startedAt    DateTime           @map("started_at") @db.Timestamptz
  /// Thời điểm hết hạn gói dịch vụ
  expiredAt    DateTime           @map("expired_at") @db.Timestamptz
  /// Chu kỳ thanh toán (Theo tháng hay theo năm)
  billingCycle BillingCycle       @map("billing_cycle")
  /// Tự động gia hạn gói khi hết chu kỳ
  autoRenew    Boolean            @default(true) @map("auto_renew")
  /// Thời điểm đăng ký gói
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật thông tin đăng ký gần nhất
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant đăng ký (khi xóa tenant thì tự động xóa lịch sử đăng ký)
  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Gói dịch vụ đăng ký (chặn xóa gói nếu đang có tenant đăng ký sử dụng)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// Các hóa đơn thanh toán liên quan đến chu kỳ đăng ký này
  payments SubscriptionPayment[]

  @@unique([id, tenantId], map: "subscriptions_id_tenant_id_key")
  @@index([tenantId, status])
  @@map("subscriptions")
}

/// Bảng lưu trữ lịch sử thanh toán hóa đơn gói SaaS của chủ trọ
model SubscriptionPayment {
  /// ID giao dịch thanh toán
  id              Int                        @id @default(autoincrement())
  /// ID của bản ghi đăng ký dịch vụ tương ứng
  subscriptionId  Int                        @map("subscription_id")
  /// ID của Tenant thực hiện thanh toán
  tenantId        Int                        @map("tenant_id")
  /// Mục đích thanh toán: gia hạn hay đổi gói
  purpose         SubscriptionPaymentPurpose @default(RENEWAL)
  /// Số tiền thanh toán thực tế
  amount          Decimal                    @db.Decimal(12, 2)
  /// Phương thức thanh toán (ví dụ: BANK_TRANSFER, VNPAY, MOMO, CREDIT_CARD)
  paymentMethod   String                     @default("QR") @map("payment_method") @db.VarChar(100)
  /// Nhà cung cấp xử lý giao dịch
  provider        String                     @default("PayOS") @db.VarChar(100)
  /// Mã đơn hàng duy nhất gửi sang PayOS
  orderCode       Int?                       @unique @default(dbgenerated("nextval('payos_order_code_seq'::regclass)")) @map("order_code")
  /// ID payment link do PayOS trả về
  paymentLinkId   String?                    @unique @map("payment_link_id") @db.VarChar(100)
  /// URL checkout do PayOS trả về
  checkoutUrl     String?                    @map("checkout_url") @db.Text
  /// Nội dung VietQR do PayOS trả về
  qrContent       String?                    @map("qr_content") @db.Text
  /// Trạng thái payment link tại PayOS
  providerStatus  String?                    @map("provider_status") @db.VarChar(50)
  /// Mã giao dịch từ cổng thanh toán hoặc ngân hàng
  transactionCode String?                    @map("transaction_code") @db.VarChar(100)
  /// Trạng thái của giao dịch thanh toán
  status          SubscriptionPaymentStatus  @default(PENDING)
  /// Thời điểm thanh toán thành công (null nếu chưa thanh toán)
  paidAt          DateTime?                  @map("paid_at") @db.Timestamptz
  /// Thời điểm payment link hết hiệu lực
  expiredAt       DateTime?                  @map("expired_at") @db.Timestamptz
  /// Thời điểm tạo yêu cầu thanh toán
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật yêu cầu thanh toán gần nhất
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  /// ID người dùng tạo checkout
  createdById     Int?                       @map("created_by_id")
  /// ID người dùng cập nhật checkout gần nhất
  updatedById     Int?                       @map("updated_by_id")

  // Các quan hệ (Relations)
  /// Bản ghi đăng ký dịch vụ tương ứng (xóa đăng ký thì xóa lịch sử thanh toán của nó)
  subscription Subscription        @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// Tenant liên kết (khi xóa tenant thì tự động xóa lịch sử thanh toán này)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Người tạo checkout
  createdBy    User?               @relation("SubscriptionPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Người cập nhật checkout gần nhất
  updatedBy    User?               @relation("SubscriptionPaymentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  /// Các webhook PayOS đã nhận cho checkout này
  webhookLogs  PaymentWebhookLog[]

  @@unique([provider, transactionCode], map: "subscription_payments_provider_transaction_code_key")
  @@index([tenantId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("subscription_payments")
}

/// Bảng đại diện cho một nhà trọ, tòa nhà, chung cư mini hoặc cụm phòng thuộc sở hữu của chủ trọ
model Property {
  /// ID định danh bất động sản
  id            Int            @id @default(autoincrement())
  /// ID của Tenant sở hữu bất động sản này
  tenantId      Int            @map("tenant_id")
  /// Tên nhà / tòa nhà trọ (ví dụ: Chung cư mini Hoa Hồng)
  name          String         @db.VarChar(255)
  /// Phân loại loại hình nhà trọ
  type          PropertyType
  /// Tên tỉnh / thành phố của nhà trọ
  province      String         @db.VarChar(100)
  /// Mã tỉnh/thành theo Quyết định 19/2025/QĐ-TTg
  provinceCode  String?        @map("province_code") @db.VarChar(2)
  /// Tên quận / huyện của nhà trọ
  district      String?        @db.VarChar(100)
  /// Tên phường / xã của nhà trọ
  ward          String         @db.VarChar(100)
  /// Mã xã/phường/đặc khu theo Quyết định 19/2025/QĐ-TTg
  wardCode      String?        @map("ward_code") @db.VarChar(5)
  /// Số nhà, tên đường chi tiết
  addressDetail String         @map("address_detail") @db.Text
  /// Vĩ độ địa lý phục vụ định vị bản đồ và tìm kiếm thông minh
  latitude      Decimal?       @db.Decimal(10, 8)
  /// Kinh độ địa lý phục vụ định vị bản đồ và tìm kiếm thông minh
  longitude     Decimal?       @db.Decimal(11, 8)
  /// Mô tả chi tiết về nhà trọ (tiện ích chung, quy định chung...)
  description   String?        @db.Text
  /// URL ảnh bìa của nhà trọ trên Cloudinary
  coverImageUrl String?        @map("cover_image_url") @db.Text
  /// Public ID của ảnh bìa trên Cloudinary để xóa/thay thế
  coverImagePublicId String?   @map("cover_image_public_id") @db.VarChar(100)
  /// Trạng thái hoạt động của tòa nhà
  status        PropertyStatus @default(ACTIVE)
  /// Thời điểm tạo nhà trọ
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật thông tin nhà trọ gần nhất
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm xóa nhà trọ (hỗ trợ xóa mềm)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant sở hữu tòa nhà (khi xóa tenant thì tự động xóa toàn bộ tòa nhà của họ)
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Danh sách các tầng trong tòa nhà trọ này
  floors      Floor[]
  /// Danh sách các phòng trọ nằm trong tòa nhà này
  rooms       Room[]
  /// ID người dùng tạo bản ghi
  createdById Int?    @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int?    @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int?    @map("deleted_by_id")

  createdBy User? @relation("PropertyCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("PropertyUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("PropertyDeleter", fields: [deletedById], references: [id])

  @@index([province, district, ward])
  @@index([provinceCode, wardCode])
  @@index([tenantId])
  @@map("properties")
}

/// Bảng quản lý danh sách các tầng trong từng tòa nhà trọ
model Floor {
  /// ID định danh tầng
  id          Int      @id @default(autoincrement())
  /// ID của Tenant quản lý
  tenantId    Int      @map("tenant_id")
  /// ID của tòa nhà chứa tầng này
  propertyId  Int      @map("property_id")
  /// Tên hiển thị của tầng (ví dụ: Tầng 1, Tầng trệt, Tầng lửng)
  name        String   @db.VarChar(100)
  /// Số tầng thực tế phục vụ sắp xếp (ví dụ: 1, 2, 3)
  floorNumber Int      @map("floor_number")
  /// Thời điểm tạo tầng
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý (khi xóa tenant thì tự động xóa các tầng tương ứng)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Tòa nhà chứa tầng này (khi xóa tòa nhà thì tự động xóa các tầng của nó)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Danh sách các phòng trọ thuộc tầng này
  rooms    Room[]

  @@map("floors")
}

/// Bảng lưu trữ thông tin chi tiết từng phòng trọ / chung cư mini
model Room {
  /// ID định danh phòng trọ
  id                Int               @id @default(autoincrement())
  /// ID của Tenant quản lý
  tenantId          Int               @map("tenant_id")
  /// ID của tòa nhà chứa phòng trọ này
  propertyId        Int               @map("property_id")
  /// ID của tầng chứa phòng trọ này (có thể null nếu nhà trọ không chia tầng rõ ràng)
  floorId           Int?              @map("floor_id")
  /// Mã định danh phòng (ví dụ: P101, P.A1)
  roomCode          String            @map("room_code") @db.VarChar(50)
  /// Tiêu đề hiển thị khi đăng tin cho thuê phòng (ví dụ: Phòng trọ khép kín, ban công thoáng mát)
  title             String            @db.VarChar(255)
  /// Diện tích sử dụng của phòng (m2)
  area              Decimal           @db.Decimal(10, 2)
  /// Số lượng người ở tối đa được phép trong phòng
  maxOccupants      Int               @map("max_occupants")
  /// Giá thuê phòng cơ bản theo tháng
  basePrice         Decimal           @map("base_price") @db.Decimal(12, 2)
  /// Số tiền đặt cọc yêu cầu khi thuê phòng
  depositAmount     Decimal           @map("deposit_amount") @db.Decimal(12, 2)
  /// Đơn giá tiền điện áp dụng cho phòng (ví dụ: 3500đ/kWh)
  electricityPrice  Decimal           @map("electricity_price") @db.Decimal(12, 2)
  /// Đơn giá tiền nước áp dụng cho phòng (ví dụ: 20000đ/m3)
  waterPrice        Decimal           @map("water_price") @db.Decimal(12, 2)
  /// Mô tả chi tiết về phòng trọ (quy định riêng của phòng, đồ đạc có sẵn...)
  description       String?           @db.Text
  /// Trạng thái thuê hiện tại của phòng trọ
  status            RoomStatus        @default(AVAILABLE)
  /// Trạng thái hiển thị tin đăng của phòng trên sàn Marketplace tìm kiếm phòng
  marketplaceStatus MarketplaceStatus @default(DRAFT) @map("marketplace_status")
  /// Thời điểm đăng tin phòng lên Marketplace lần đầu hoặc gần nhất
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz
  /// Thời điểm tạo phòng
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật thông tin phòng gần nhất
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm xóa phòng (hỗ trợ xóa mềm)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý (khi xóa tenant thì tự động xóa toàn bộ phòng thuộc tenant đó)
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Tòa nhà chứa phòng trọ này (khi xóa tòa nhà thì tự động xóa toàn bộ phòng bên trong)
  property               Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Tầng chứa phòng trọ này (khi xóa tầng thì thiết lập trường floorId về null để phòng không bị mất liên kết)
  floor                  Floor?                   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  /// Danh sách hình ảnh thực tế của phòng trọ
  images                 RoomImage[]
  /// Danh sách các tiện ích được trang bị trong phòng trọ này
  amenities              RoomAmenity[]
  /// Danh sách lịch sử khách đã từng thuê phòng này
  rentalHistories        RentalHistory[]
  /// Danh sách nhật ký khách xem phòng trọ này trên Marketplace
  viewLogs               RoomViewLog[]
  /// Danh sách khách thuê đánh dấu yêu thích phòng này
  favorites              FavoriteRoom[]
  /// Lịch hẹn xem phòng thực tế tại phòng trọ này
  viewingAppointments    RoomViewingAppointment[]
  /// Các yêu cầu xin thuê phòng trọ này
  rentalRequests         RentalRequest[]
  /// Danh sách các hợp đồng thuê phòng trọ này
  contracts              Contract[]
  serviceAssignments     ServiceAssignment[]
  /// Danh sách tài sản trong phòng trọ này
  roomAssets             RoomAsset[]
  /// Danh sách biên bản bàn giao phòng trọ này
  handoverRecords        HandoverRecord[]
  /// Danh sách đồng hồ điện nước lắp tại phòng trọ này
  utilityMeters          UtilityMeter[]
  /// Danh sách chỉ số điện nước của phòng trọ này
  meterReadings          MeterReading[]
  /// Danh sách các tác vụ AI OCR của phòng trọ này
  ocrJobs                OcrJob[]
  /// Danh sách hóa đơn của phòng trọ này
  invoices               Invoice[]
  /// Danh sách công nợ phát sinh từ phòng trọ này
  debts                  Debt[]
  /// Danh sách các sự cố/ticket của phòng trọ này
  tickets                Ticket[]
  /// Danh sách các phòng chat liên quan đến phòng trọ này
  conversations          Conversation[]
  /// Danh sách các đánh giá về phòng trọ này
  reviews                Review[]
  /// Bảng điểm uy tín của phòng trọ này
  reputationScores       ReputationScore[]
  /// Lịch sử gửi duyệt và kiểm duyệt marketplace
  marketplaceModerations MarketplaceModeration[]
  /// ID người dùng tạo bản ghi
  createdById            Int?                     @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById            Int?                     @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById            Int?                     @map("deleted_by_id")

  createdBy User? @relation("RoomCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("RoomUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("RoomDeleter", fields: [deletedById], references: [id])

  @@unique([propertyId, roomCode]) // Đảm bảo trong cùng 1 tòa nhà không thể có 2 phòng trùng mã phòng
  @@index([propertyId])
  @@index([basePrice])
  @@index([area])
  @@index([status, marketplaceStatus])
  @@index([marketplaceStatus, updatedAt])
  @@index([tenantId, status])
  @@map("rooms")
}

/// Lịch sử chuyển trạng thái tin đăng marketplace
model MarketplaceModeration {
  id         Int                @id @default(autoincrement())
  roomId     Int                @map("room_id")
  tenantId   Int                @map("tenant_id")
  actorId    Int?               @map("actor_id")
  fromStatus MarketplaceStatus? @map("from_status")
  toStatus   MarketplaceStatus  @map("to_status")
  reason     String?            @db.Text
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([tenantId, createdAt])
  @@index([toStatus, createdAt])
  @@map("marketplace_moderations")
}

/// Bảng lưu trữ hình ảnh chi tiết của phòng trọ
model RoomImage {
  /// ID hình ảnh (UUID)
  id          Int      @id @default(autoincrement())
  /// ID của phòng chứa hình ảnh này
  roomId      Int      @map("room_id")
  /// Đường dẫn lưu trữ hình ảnh (ví dụ: trên S3 hoặc Cloudinary)
  url         String   @db.Text
  /// Public ID của ảnh trên Cloudinary để có thể xóa tài nguyên khi xóa ảnh
  publicId    String?  @map("public_id") @db.Text
  /// Ghi chú mô tả bức ảnh (ví dụ: Nhà vệ sinh, Góc bếp)
  caption     String?  @db.VarChar(255)
  /// Thứ tự sắp xếp hiển thị ảnh
  sortOrder   Int      @default(0) @map("sort_order")
  /// Đánh dấu là ảnh bìa đại diện của phòng trọ
  isThumbnail Boolean  @default(false) @map("is_thumbnail")
  /// Thời điểm tải ảnh lên
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Phòng trọ tương ứng (khi xóa phòng trọ thì tự động xóa toàn bộ ảnh liên quan)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

/// Bảng lưu trữ danh mục các tiện ích dùng chung toàn hệ thống (ví dụ: Wifi, Điều hòa...)
model Amenity {
  /// ID tiện ích (UUID)
  id       Int     @id @default(autoincrement())
  /// Tên tiện ích (ví dụ: Máy giặt, Điều hòa, Bãi giữ xe, Thang máy...)
  name     String  @db.VarChar(100)
  /// Mã icon hiển thị (ví dụ: fa-wifi, air-conditioner)
  icon     String? @db.VarChar(100)
  /// Nhóm phân loại tiện ích (ví dụ: Tiện nghi phòng, An ninh, Tiện ích tòa nhà)
  category String  @db.VarChar(100)
  /// Trạng thái tiện ích có đang hoạt động/cho phép sử dụng trên hệ thống không
  isActive Boolean @default(true) @map("is_active")

  // Các quan hệ (Relations)
  /// Danh sách các phòng trọ sở hữu tiện ích này
  rooms RoomAmenity[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("AmenityCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("AmenityUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("AmenityDeleter", fields: [deletedById], references: [id])

  @@map("amenities")
}

/// Bảng trung gian biểu diễn mối quan hệ nhiều-nhiều giữa Phòng và Tiện ích
model RoomAmenity {
  /// ID phòng trọ
  roomId    Int @map("room_id")
  /// ID tiện ích
  amenityId Int @map("amenity_id")

  // Các quan hệ (Relations)
  /// Bản ghi phòng trọ tương ứng (xóa phòng thì tự động xóa liên kết tiện ích của nó)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Bản ghi tiện ích tương ứng (xóa tiện ích hệ thống thì tự động xóa liên kết của nó với các phòng)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@map("room_amenities")
}

/// Lời mời tạo tài khoản người thuê do chủ trọ phát hành.
model RenterInvitation {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  email          String    @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  codeHash       String    @map("code_hash") @db.Text
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  acceptedUserId Int?      @map("accepted_user_id")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdById    Int       @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acceptedUser User?  @relation("AcceptedRenterInvitations", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdBy    User   @relation("CreatedRenterInvitations", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
  @@index([email, expiresAt])
  @@index([acceptedUserId])
  @@map("renter_invitations")
}

/// Hồ sơ thông tin chi tiết người thuê trên Mobile App
model RenterProfile {
  /// ID hồ sơ (UUID)
  id                    Int                @id @default(autoincrement())
  /// ID tài khoản người dùng liên kết (quan hệ 1-1)
  userId                Int                @unique @map("user_id")
  /// Ngày tháng năm sinh
  dateOfBirth           DateTime?          @map("date_of_birth") @db.Date
  /// Giới tính
  gender                Gender?            @default(OTHER)
  /// Số CCCD hoặc CMND
  identityNumber        String?            @map("identity_number") @db.VarChar(50)
  /// Đường dẫn lưu ảnh CCCD mặt trước
  identityFrontUrl      String?            @map("identity_front_url") @db.Text
  /// Đường dẫn lưu ảnh CCCD mặt sau
  identityBackUrl       String?            @map("identity_back_url") @db.Text
  /// Địa chỉ thường trú (trên hộ khẩu/CCCD)
  permanentAddress      String?            @map("permanent_address") @db.Text
  /// Nghề nghiệp hiện tại
  occupation            String?            @db.VarChar(100)
  /// Tên người liên hệ khẩn cấp
  emergencyContactName  String?            @map("emergency_contact_name") @db.VarChar(100)
  /// Số điện thoại liên hệ khẩn cấp
  emergencyContactPhone String?            @map("emergency_contact_phone") @db.VarChar(50)
  /// Trạng thái xác thực hồ sơ bởi hệ thống (chặn thuê phòng nếu REJECTED hoặc UNVERIFIED tùy cấu hình)
  verificationStatus    VerificationStatus @default(UNVERIFIED) @map("verification_status")
  /// Thời điểm tạo hồ sơ
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật hồ sơ gần nhất
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tài khoản người dùng liên kết (xóa tài khoản thì cascade xóa hồ sơ)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("renter_profiles")
}

/// Bảng ghi nhận lịch sử thuê phòng của khách trọ
model RentalHistory {
  /// ID bản ghi lịch sử (UUID)
  id         Int                 @id @default(autoincrement())
  /// ID người thuê (tài khoản User)
  renterId   Int                 @map("renter_id")
  /// ID Tenant (chủ trọ quản lý)
  tenantId   Int                 @map("tenant_id")
  /// ID phòng thuê
  roomId     Int                 @map("room_id")
  /// ID hợp đồng thuê liên quan
  contractId Int                 @map("contract_id")
  /// Ngày bắt đầu thuê thực tế
  startedAt  DateTime            @map("started_at") @db.Date
  /// Ngày trả phòng/kết thúc thực tế
  endedAt    DateTime?           @map("ended_at") @db.Date
  /// Trạng thái lịch sử thuê phòng
  status     RentalHistoryStatus @default(ACTIVE)
  /// Thời điểm ghi nhận bản ghi
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tài khoản người thuê (chặn xóa người thuê nếu đang có lịch sử thuê, hoặc giữ lại)
  renter   User     @relation(fields: [renterId], references: [id], onDelete: Restrict)
  /// Tenant quản lý
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng thuê (chặn xóa phòng nếu đang thuê hoặc chuyển cấu hình để lưu lịch sử)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// Hợp đồng thuê liên quan
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId])
  @@index([tenantId, status])
  @@index([renterId, status])
  @@map("rental_histories")
}

/// Bảng ghi nhận nhật ký xem phòng trọ trên sàn Marketplace phục vụ gợi ý AI
model RoomViewLog {
  /// ID bản ghi log (UUID)
  id        Int      @id @default(autoincrement())
  /// ID người dùng xem phòng (null nếu là khách vãng lai chưa đăng nhập)
  userId    Int?     @map("user_id")
  /// ID phòng trọ được xem
  roomId    Int      @map("room_id")
  /// Địa chỉ IP của người truy cập
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  /// Chuỗi thông tin trình duyệt và thiết bị (User Agent)
  userAgent String?  @map("user_agent") @db.Text
  /// Thời điểm thực hiện hành động xem
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tài khoản người dùng (nếu có, xóa người dùng thì xóa log xem phòng tương ứng)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Phòng trọ tương ứng (xóa phòng thì tự động cascade xóa log)
  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_view_logs")
}

/// Bảng trung gian lưu danh sách phòng yêu thích của người dùng
model FavoriteRoom {
  /// ID tài khoản người dùng thích phòng
  userId    Int      @map("user_id")
  /// ID phòng trọ được thích
  roomId    Int      @map("room_id")
  /// Thời điểm thêm phòng vào danh sách yêu thích
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tài khoản người dùng
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Phòng trọ được thích
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("favorite_rooms")
}

/// Bảng quản lý lịch hẹn xem phòng trọ trực tiếp
model RoomViewingAppointment {
  /// ID cuộc hẹn (UUID)
  id              Int               @id @default(autoincrement())
  /// ID Tenant quản lý nhà trọ
  tenantId        Int               @map("tenant_id")
  /// ID phòng trọ muốn xem
  roomId          Int               @map("room_id")
  /// ID tài khoản khách thuê hẹn xem phòng
  renterId        Int               @map("renter_id")
  /// ID tài khoản nhân viên được phân công dẫn khách đi xem (null nếu chưa phân công)
  assignedStaffId Int?              @map("assigned_staff_id")
  /// Thời điểm hẹn xem phòng trọ
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz
  /// Ghi chú, lời nhắn của khách thuê gửi chủ trọ
  note            String?           @db.Text
  /// Ghi chú riêng của chủ trọ/nhân viên
  landlordNote    String?           @map("landlord_note") @db.Text
  /// Trạng thái của cuộc hẹn
  status          AppointmentStatus @default(PENDING)
  /// Thời điểm tạo cuộc hẹn
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật lịch hẹn gần nhất
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý (xóa tenant thì xóa cuộc hẹn)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ cần xem (xóa phòng thì tự động xóa cuộc hẹn)
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Khách thuê (xóa khách thuê thì tự động xóa cuộc hẹn liên quan)
  renter         User            @relation("RenterAppointments", fields: [renterId], references: [id], onDelete: Cascade)
  /// Nhân viên được phân công (xóa nhân viên thì gỡ liên kết khỏi lịch hẹn)
  assignedStaff  User?           @relation("StaffAppointments", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  /// Các yêu cầu thuê được tạo ra sau cuộc hẹn này
  rentalRequests RentalRequest[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("RoomViewingAppointmentCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("RoomViewingAppointmentUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("RoomViewingAppointmentDeleter", fields: [deletedById], references: [id])

  @@map("room_viewing_appointments")
}

/// Bảng quản lý các yêu cầu thuê phòng từ khách trọ gửi đến
model RentalRequest {
  /// ID yêu cầu thuê (UUID)
  id                Int                 @id @default(autoincrement())
  /// ID Tenant quản lý phòng trọ
  tenantId          Int                 @map("tenant_id")
  /// ID phòng trọ xin thuê
  roomId            Int                 @map("room_id")
  /// ID tài khoản người gửi yêu cầu thuê
  renterId          Int                 @map("renter_id")
  /// ID lịch hẹn xem phòng trước đó (nếu có, hỗ trợ truy vết hành trình khách hàng)
  appointmentId     Int?                @map("appointment_id")
  /// Lời nhắn kèm theo của khách thuê gửi chủ trọ
  message           String?             @db.Text
  /// Ngày dự kiến muốn dọn vào ở
  expectedStartDate DateTime            @map("expected_start_date") @db.Date
  /// Trạng thái xử lý yêu cầu thuê
  status            RentalRequestStatus @default(PENDING)
  /// Thời điểm gửi yêu cầu thuê
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật yêu cầu gần nhất
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ xin thuê
  room        Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Khách thuê
  renter      User                    @relation(fields: [renterId], references: [id], onDelete: Cascade)
  /// Cuộc hẹn xem phòng tương ứng (nếu có, khi cuộc hẹn bị xóa thì gỡ liên kết trong yêu cầu thuê)
  appointment RoomViewingAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  /// Các hợp đồng được khởi tạo từ yêu cầu thuê được phê duyệt này
  contracts   Contract[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("RentalRequestCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("RentalRequestUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("RentalRequestDeleter", fields: [deletedById], references: [id])

  @@map("rental_requests")
}

/// Bảng mẫu văn bản hợp đồng thuê trọ của từng chủ trọ
model ContractTemplate {
  /// ID mẫu hợp đồng (UUID)
  id              Int      @id @default(autoincrement())
  /// ID Tenant tạo mẫu hợp đồng này
  tenantId        Int      @map("tenant_id")
  /// Tên gợi nhớ mẫu hợp đồng (ví dụ: Mẫu hợp đồng phòng đơn, mẫu căn hộ)
  name            String   @db.VarChar(255)
  /// Nội dung chi tiết của mẫu chứa định dạng Markdown hoặc HTML
  content         String   @db.Text
  /// Cấu trúc danh sách các biến sẽ được thay thế tự động bằng JSON Schema
  variablesSchema Json     @map("variables_schema") @db.JsonB
  /// Đánh dấu là mẫu mặc định sẽ tự động chọn khi tạo hợp đồng mới
  isDefault       Boolean  @default(false) @map("is_default")
  /// Thời điểm tạo mẫu hợp đồng
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật mẫu hợp đồng gần nhất
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant sở hữu (xóa tenant thì xóa mẫu hợp đồng)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Các hợp đồng thực tế được tạo ra từ mẫu này
  contracts Contract[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("ContractTemplateCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("ContractTemplateUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("ContractTemplateDeleter", fields: [deletedById], references: [id])

  @@map("contract_templates")
}

/// Bảng lưu trữ thông tin hợp đồng thuê phòng chính thức
model Contract {
  /// ID hợp đồng (UUID)
  id                 Int                  @id @default(autoincrement())
  /// ID Tenant quản lý phòng trọ
  tenantId           Int                  @map("tenant_id")
  /// ID phòng cho thuê
  roomId             Int                  @map("room_id")
  /// ID tài khoản khách thuê chính (người đứng tên ký hợp đồng)
  renterId           Int                  @map("renter_id")
  /// ID yêu cầu thuê gốc (null nếu tạo hợp đồng trực tiếp không qua yêu cầu trên sàn)
  rentalRequestId    Int?                 @map("rental_request_id")
  /// ID mẫu hợp đồng sử dụng để khởi tạo văn bản hợp đồng (null nếu tự soạn thảo)
  templateId         Int?                 @map("template_id")
  /// Mã số hợp đồng duy nhất (phục vụ quản lý và đối soát)
  contractCode       String               @unique @map("contract_code") @db.VarChar(100)
  /// Ngày hợp đồng bắt đầu có hiệu lực
  startDate          DateTime             @map("start_date") @db.Date
  /// Ngày hợp đồng hết hạn thuê
  endDate            DateTime             @map("end_date") @db.Date
  /// Giá thuê phòng thực tế theo tháng trong hợp đồng
  monthlyPrice       Decimal              @map("monthly_price") @db.Decimal(12, 2)
  /// Tiền đặt cọc thực tế khách đã đóng
  depositAmount      Decimal              @map("deposit_amount") @db.Decimal(12, 2)
  /// Chu kỳ đóng tiền trọ (Hàng tháng hoặc Hàng quý)
  billingCycle       ContractBillingCycle @map("billing_cycle")
  /// Ngày hạn chót đóng tiền trọ hằng tháng (ví dụ: ngày 5 hằng tháng)
  paymentDueDay      Int                  @map("payment_due_day")
  /// Bản chụp nội dung văn bản hợp đồng đầy đủ tại thời điểm ký kết
  contentSnapshot    String               @map("content_snapshot") @db.Text
  /// Trạng thái pháp lý của hợp đồng
  status             ContractStatus       @default(DRAFT)
  /// Chữ ký điện tử của chủ trọ (Base64)
  landlordSignature  String?              @map("landlord_signature") @db.Text
  /// Chữ ký điện tử của khách thuê chính (Base64)
  renterSignature    String?              @map("renter_signature") @db.Text
  /// Thời điểm chủ trọ ký xác nhận online (null nếu chưa ký)
  signedByLandlordAt DateTime?            @map("signed_by_landlord_at") @db.Timestamptz
  /// Thời điểm khách thuê ký xác nhận online (null nếu chưa ký)
  signedByRenterAt   DateTime?            @map("signed_by_renter_at") @db.Timestamptz
  /// Thời điểm tạo hợp đồng trên hệ thống
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật hợp đồng gần nhất
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm xóa hợp đồng (hỗ trợ xóa mềm)
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng thuê (chặn xóa phòng nếu đang có hợp đồng)
  room                Room                         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// Khách thuê chính
  renter              User                         @relation(fields: [renterId], references: [id], onDelete: Restrict)
  /// Yêu cầu thuê gốc (gỡ liên kết nếu yêu cầu thuê bị xóa)
  rentalRequest       RentalRequest?               @relation(fields: [rentalRequestId], references: [id], onDelete: SetNull)
  /// Mẫu hợp đồng gốc (gỡ liên kết nếu mẫu hợp đồng bị xóa)
  template            ContractTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Danh sách thành viên cùng ở phòng thuộc hợp đồng này
  members             ContractMember[]
  serviceAssignments  ServiceAssignment[]
  /// Danh sách file xuất bản (PDF/DOCX) liên quan đến hợp đồng
  files               ContractFile[]
  /// Các yêu cầu thanh lý/trả phòng của hợp đồng này
  terminationRequests ContractTerminationRequest[]
  /// Lịch sử thuê phòng được ghi nhận từ hợp đồng này
  rentalHistories     RentalHistory[]
  /// Danh sách biên bản bàn giao liên quan đến hợp đồng này
  handoverRecords     HandoverRecord[]
  /// Danh sách chỉ số điện nước ghi nhận trong thời gian hợp đồng có hiệu lực
  meterReadings       MeterReading[]
  /// Danh sách hóa đơn liên quan đến hợp đồng này
  invoices            Invoice[]
  /// Danh sách công nợ phát sinh từ hợp đồng này
  debts               Debt[]
  /// Danh sách các sự cố/ticket liên quan đến hợp đồng này
  tickets             Ticket[]
  /// Danh sách các phòng chat thuộc hợp đồng này
  conversations       Conversation[]
  /// Danh sách các đánh giá của khách thuê liên quan đến hợp đồng này
  reviews             Review[]
  /// ID người dùng tạo bản ghi
  createdById         Int?                         @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById         Int?                         @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById         Int?                         @map("deleted_by_id")

  createdBy User? @relation("ContractCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("ContractUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("ContractDeleter", fields: [deletedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([contractCode])
  @@index([status])
  @@map("contracts")
}

/// Bảng lưu danh sách người ở cùng phòng trọ theo hợp đồng
model ContractMember {
  /// ID bản ghi thành viên (UUID)
  id         Int                @id @default(autoincrement())
  /// ID hợp đồng liên quan
  contractId Int                @map("contract_id")
  /// ID tài khoản người dùng của thành viên ở cùng
  userId     Int                @map("user_id")
  /// Vai trò của thành viên trong hợp đồng (Ví dụ: MAIN_RENTER hoặc CO_RENTER)
  role       ContractMemberRole @default(CO_RENTER)
  /// Thời điểm thêm thành viên vào hợp đồng
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Hợp đồng thuê liên quan (xóa hợp đồng thì tự động xóa liên kết các thành viên cùng phòng)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Tài khoản người dùng (xóa tài khoản thì tự động xóa liên kết thành viên này)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@map("contract_members")
}

/// Bảng lưu trữ file văn bản hợp đồng đã xuất ra dạng PDF hoặc DOCX
model ContractFile {
  /// ID file (UUID)
  id         Int      @id @default(autoincrement())
  /// ID hợp đồng liên quan
  contractId Int      @map("contract_id")
  /// Đường dẫn lưu trữ file trên máy chủ hoặc cloud storage
  fileUrl    String   @map("file_url") @db.Text
  /// Định dạng file (ví dụ: PDF, DOCX)
  fileType   String   @map("file_type") @db.VarChar(50)
  /// Phiên bản của tài liệu hợp đồng (tăng dần khi cập nhật)
  version    Int      @default(1)
  /// Thời điểm tạo file tài liệu
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Hợp đồng liên quan (xóa hợp đồng thì tự động xóa các file PDF đính kèm)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_files")
}

/// Bảng quản lý các yêu cầu chấm dứt hoặc thanh lý hợp đồng thuê phòng
model ContractTerminationRequest {
  /// ID yêu cầu thanh lý (UUID)
  id                  Int                      @id @default(autoincrement())
  /// ID Tenant quản lý phòng
  tenantId            Int                      @map("tenant_id")
  /// ID hợp đồng muốn chấm dứt
  contractId          Int                      @map("contract_id")
  // (removed old requestedBy)
  /// Lý do xin trả phòng/chấm dứt hợp đồng trọ
  reason              String                   @db.Text
  /// Ngày dự kiến khách dọn đồ ra khỏi phòng trọ
  expectedMoveOutDate DateTime                 @map("expected_move_out_date") @db.Date
  /// Trạng thái xử lý yêu cầu thanh lý
  status              TerminationRequestStatus @default(PENDING)
  /// Ghi chú duyệt hoặc lý do từ chối của chủ trọ
  reviewNote          String?                  @map("review_note") @db.Text
  /// Người duyệt hoặc từ chối yêu cầu
  reviewedById        Int?                     @map("reviewed_by_id")
  /// Thời điểm duyệt hoặc từ chối
  reviewedAt          DateTime?                @map("reviewed_at") @db.Timestamptz
  /// Ngày khách thuê thực tế trả phòng
  actualMoveOutDate   DateTime?                @map("actual_move_out_date") @db.Date
  /// Thời điểm hoàn tất thanh lý
  completedAt         DateTime?                @map("completed_at") @db.Timestamptz
  /// Ghi chú hoàn tất và xác nhận nghĩa vụ còn lại
  completionNote      String?                  @map("completion_note") @db.Text
  /// Tổng công nợ còn mở tại thời điểm hoàn tất
  outstandingDebt     Decimal?                 @map("outstanding_debt") @db.Decimal(12, 2)
  /// Thời điểm gửi yêu cầu
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật yêu cầu gần nhất
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Hợp đồng thuê liên quan (xóa hợp đồng thì xóa yêu cầu trả phòng)
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Người duyệt hoặc từ chối yêu cầu
  reviewedBy User?    @relation("ContractTerminationRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  // (removed old requestedUser)
  // (removed old requestedUser)

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("ContractTerminationRequestCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("ContractTerminationRequestUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("ContractTerminationRequestDeleter", fields: [deletedById], references: [id])

  @@index([tenantId, status])
  @@index([contractId, status])
  @@map("contract_termination_requests")
}

/// Bảng danh mục loại tài sản (Ví dụ: Giường, Tủ, Điều hòa, Chìa khóa...)
model AssetCategory {
  /// ID danh mục tài sản (UUID)
  id          Int       @id @default(autoincrement())
  /// Tenant sở hữu danh mục
  tenantId    Int       @map("tenant_id")
  /// Tên loại tài sản
  name        String    @db.VarChar(100)
  /// Mô tả chi tiết loại tài sản
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Danh sách các tài sản thực tế trong các phòng thuộc danh mục này
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomAssets RoomAsset[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("AssetCategoryCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("AssetCategoryUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("AssetCategoryDeleter", fields: [deletedById], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("asset_categories")
}

/// Bảng quản lý thông tin các tài sản được trang bị trong từng phòng trọ
model RoomAsset {
  /// ID tài sản phòng (UUID)
  id          Int            @id @default(autoincrement())
  /// ID Tenant quản lý
  tenantId    Int            @map("tenant_id")
  /// ID phòng trọ chứa tài sản này
  roomId      Int            @map("room_id")
  /// ID danh mục loại tài sản
  categoryId  Int            @map("category_id")
  /// Tên cụ thể của tài sản (ví dụ: Máy lạnh Daikin Inverter 1.5HP)
  name        String         @db.VarChar(255)
  /// Số lượng trang bị trong phòng
  quantity    Int            @default(1)
  /// Trạng thái hao mòn vật lý của tài sản
  condition   AssetCondition @default(GOOD)
  /// Mô tả tình trạng chi tiết hoặc ghi chú
  description String?        @db.Text
  /// Đường dẫn ảnh chụp hiện trạng tài sản
  imageUrl    String?        @map("image_url") @db.Text
  /// Thời điểm tạo bản ghi tài sản
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật thông tin tài sản gần nhất
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm xóa tài sản (hỗ trợ xóa mềm)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant sở hữu tài sản (xóa tenant thì cascade xóa tài sản)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng chứa tài sản (xóa phòng thì cascade xóa tài sản bên trong)
  room          Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Danh mục tài sản liên quan (chặn xóa danh mục nếu đang có tài sản tham chiếu)
  category      AssetCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Lịch sử bàn giao tài sản này trong các biên bản
  handoverItems HandoverAssetItem[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("RoomAssetCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("RoomAssetUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("RoomAssetDeleter", fields: [deletedById], references: [id])

  @@index([tenantId, roomId, deletedAt])
  @@map("room_assets")
}

/// Bảng quản lý biên bản bàn giao tài sản khi khách thuê nhận hoặc trả phòng trọ
model HandoverRecord {
  /// ID biên bản bàn giao (UUID)
  id                 Int            @id @default(autoincrement())
  /// ID Tenant quản lý
  tenantId           Int            @map("tenant_id")
  /// ID hợp đồng thuê liên quan trực tiếp
  contractId         Int            @map("contract_id")
  /// ID phòng trọ được bàn giao
  roomId             Int            @map("room_id")
  /// Phân loại là bàn giao khi nhận phòng (Check-in) hay trả phòng (Check-out)
  type               HandoverType
  /// Ghi chú tổng quan về tình trạng bàn giao phòng
  note               String?        @db.Text
  /// Thời điểm chủ trọ ký tên xác nhận online
  signedByLandlordAt DateTime?      @map("signed_by_landlord_at") @db.Timestamptz
  /// Thời điểm khách thuê ký tên xác nhận online
  signedByRenterAt   DateTime?      @map("signed_by_renter_at") @db.Timestamptz
  /// Người đại diện chủ trọ đã xác nhận
  signedByLandlordId Int?           @map("signed_by_landlord_id")
  /// Người thuê chính đã xác nhận
  signedByRenterId   Int?           @map("signed_by_renter_id")
  /// Trạng thái xác nhận của biên bản bàn giao
  status             HandoverStatus @default(DRAFT)
  /// Phiên bản nội dung; tăng khi xử lý tranh chấp
  version            Int            @default(1)
  /// SHA-256 của nội dung và snapshot tài sản
  contentHash        String         @map("content_hash") @db.VarChar(64)
  /// Thời điểm đủ xác nhận từ hai phía
  confirmedAt        DateTime?      @map("confirmed_at") @db.Timestamptz
  /// Thông tin tranh chấp
  disputedById       Int?           @map("disputed_by_id")
  disputeReason      String?        @map("dispute_reason") @db.Text
  disputedAt         DateTime?      @map("disputed_at") @db.Timestamptz
  /// Thông tin xử lý tranh chấp
  resolvedById       Int?           @map("resolved_by_id")
  resolutionNote     String?        @map("resolution_note") @db.Text
  resolvedAt         DateTime?      @map("resolved_at") @db.Timestamptz
  /// Thời điểm lập biên bản bàn giao
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật biên bản
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Hợp đồng thuê liên quan (xóa hợp đồng thì cascade xóa biên bản bàn giao)
  contract         Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Phòng trọ bàn giao (xóa phòng thì cascade xóa biên bản bàn giao của phòng đó)
  room             Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Chi tiết tình trạng các tài sản được ghi nhận trong biên bản này
  assetItems       HandoverAssetItem[]
  signedByLandlord User?               @relation("HandoverLandlordSigner", fields: [signedByLandlordId], references: [id], onDelete: SetNull)
  signedByRenter   User?               @relation("HandoverRenterSigner", fields: [signedByRenterId], references: [id], onDelete: SetNull)
  disputedBy       User?               @relation("HandoverDisputer", fields: [disputedById], references: [id], onDelete: SetNull)
  resolvedBy       User?               @relation("HandoverResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("HandoverRecordCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("HandoverRecordUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("HandoverRecordDeleter", fields: [deletedById], references: [id])

  @@unique([contractId, type])
  @@index([tenantId, status])
  @@map("handover_records")
}

/// Bảng chi tiết trạng thái từng tài sản tại thời điểm lập biên bản bàn giao
model HandoverAssetItem {
  /// ID chi tiết bàn giao tài sản (UUID)
  id               Int            @id @default(autoincrement())
  /// ID biên bản bàn giao tương ứng
  handoverRecordId Int            @map("handover_record_id")
  /// ID tài sản phòng được bàn giao
  roomAssetId      Int            @map("room_asset_id")
  /// Tên và danh mục tài sản được snapshot tại thời điểm lập biên bản
  assetName        String         @map("asset_name") @db.VarChar(255)
  categoryName     String         @map("category_name") @db.VarChar(100)
  /// Số lượng theo inventory/check-in và số lượng thực tế
  expectedQuantity Int            @map("expected_quantity")
  actualQuantity   Int            @map("actual_quantity")
  /// Trạng thái chất lượng tài sản được ghi nhận lúc bàn giao
  condition        AssetCondition @default(GOOD)
  /// Ghi chú chi tiết cho tài sản này (ví dụ: bị trầy xước nhẹ ở góc)
  note             String?        @db.Text
  /// Đường dẫn hình ảnh chụp làm bằng chứng tình trạng tài sản lúc bàn giao
  imageUrl         String?        @map("image_url") @db.Text

  // Các quan hệ (Relations)
  /// Biên bản bàn giao chứa dòng chi tiết này (xóa biên bản thì cascade xóa chi tiết)
  handoverRecord HandoverRecord @relation(fields: [handoverRecordId], references: [id], onDelete: Cascade)
  /// Tài sản phòng được tham chiếu (chặn xóa tài sản phòng nếu đang nằm trong biên bản bàn giao để giữ lịch sử pháp lý)
  roomAsset      RoomAsset      @relation(fields: [roomAssetId], references: [id], onDelete: Restrict)

  @@unique([handoverRecordId, roomAssetId])
  @@map("handover_asset_items")
}

/// Bảng quản lý thông tin các đầu đồng hồ đo điện, đo nước lắp đặt tại phòng
model UtilityMeter {
  /// ID đồng hồ (UUID)
  id        Int         @id @default(autoincrement())
  /// ID Tenant quản lý
  tenantId  Int         @map("tenant_id")
  /// ID phòng lắp đặt đồng hồ
  roomId    Int         @map("room_id")
  /// Phân loại đồng hồ đo điện hay đo nước
  type      MeterType
  /// Mã số ký hiệu của đồng hồ vật lý phục vụ đối soát
  meterCode String      @map("meter_code") @db.VarChar(100)
  /// Đơn vị đo lường (ví dụ: kWh cho điện, m3 cho nước)
  unit      String      @default("kWh") @db.VarChar(20)
  /// Trạng thái hoạt động của đồng hồ
  status    MeterStatus @default(ACTIVE)
  /// Thời điểm tạo bản ghi đồng hồ
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng lắp đặt đồng hồ (xóa phòng thì cascade xóa đồng hồ kèm theo)
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Lịch sử các chỉ số đo tiêu thụ hằng tháng được ghi nhận từ đồng hồ này
  readings MeterReading[]
  /// Lịch sử các tác vụ quét AI OCR chỉ số từ hình ảnh của đồng hồ này
  ocrJobs  OcrJob[]

  @@unique([roomId, type]) // Mỗi phòng trọ chỉ có tối đa 1 đồng hồ điện và 1 đồng hồ nước
  @@map("utility_meters")
}

/// Bảng ghi nhận chỉ số tiêu thụ điện nước hằng tháng phục vụ tính hóa đơn tiền phòng
model MeterReading {
  /// ID bản ghi ghi nhận chỉ số (UUID)
  id            Int           @id @default(autoincrement())
  /// ID Tenant quản lý
  tenantId      Int           @map("tenant_id")
  /// ID phòng ghi nhận chỉ số
  roomId        Int           @map("room_id")
  /// ID đồng hồ đo tương ứng
  meterId       Int           @map("meter_id")
  /// ID hợp đồng thuê phòng hiệu lực tại thời điểm ghi nhận (nullable nếu phòng trống)
  contractId    Int?          @map("contract_id")
  /// Tháng/năm ghi nhận chỉ số tính toán (định dạng ngày 1 của tháng ghi nhận)
  billingMonth  DateTime      @map("billing_month") @db.Date
  /// Chỉ số đồng hồ cũ đầu kỳ
  previousValue Decimal       @map("previous_value") @db.Decimal(12, 2)
  /// Chỉ số đồng hồ mới cuối kỳ
  currentValue  Decimal       @map("current_value") @db.Decimal(12, 2)
  /// Số lượng tiêu thụ thực tế trong kỳ (Chỉ số mới - Chỉ số cũ)
  consumption   Decimal       @db.Decimal(12, 2)
  /// Đơn giá áp dụng cho một đơn vị đo trong kỳ
  unitPrice     Decimal       @map("unit_price") @db.Decimal(12, 2)
  /// Tổng thành tiền chưa thuế phí (Số lượng tiêu thụ * Đơn giá)
  amount        Decimal       @db.Decimal(12, 2)
  /// Đường dẫn hình ảnh chụp mặt đồng hồ làm bằng chứng xác thực chỉ số
  imageUrl      String?       @map("image_url") @db.Text
  /// Phương thức thu thập chỉ số (nhập tay, quét ảnh bằng AI OCR, import Excel)
  source        ReadingSource @default(MANUAL)
  /// Trạng thái kiểm duyệt chỉ số
  status        ReadingStatus @default(DRAFT)
  // (removed old recordedBy)
  /// Thời điểm thực hiện hành động ghi nhận chỉ số
  recordedAt    DateTime      @default(now()) @map("recorded_at") @db.Timestamptz
  /// ID tác vụ OCR đã tạo chỉ số này, dùng để truy vết và chống duyệt lặp
  ocrJobId      Int?          @unique @map("ocr_job_id")

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ liên quan
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Đồng hồ đo tương ứng (xóa đồng hồ thì cascade xóa lịch sử chỉ số của nó)
  meter        UtilityMeter  @relation(fields: [meterId], references: [id], onDelete: Cascade)
  /// Hợp đồng thuê phòng liên quan (gỡ liên kết nếu hợp đồng bị xóa)
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  // (removed old recordedByUser)
  /// Chi tiết hóa đơn liên quan đã sử dụng chỉ số tiêu thụ này để tính tiền
  invoiceItems InvoiceItem[]
  /// Tác vụ OCR nguồn của chỉ số (nếu được tạo từ ảnh)
  ocrJob       OcrJob?       @relation(fields: [ocrJobId], references: [id], onDelete: SetNull)

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("MeterReadingCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("MeterReadingUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("MeterReadingDeleter", fields: [deletedById], references: [id])

  @@unique([meterId, billingMonth]) // Tránh ghi chỉ số trùng lặp nhiều lần cho cùng 1 đồng hồ trong cùng 1 tháng
  @@index([tenantId, billingMonth])
  @@index([status])
  @@map("meter_readings")
}

/// Bảng quản lý lịch sử các tác vụ xử lý nhận diện chỉ số đồng hồ bằng AI OCR từ ảnh chụp
model OcrJob {
  /// ID tác vụ OCR (UUID)
  id              Int          @id @default(autoincrement())
  /// ID Tenant quản lý
  tenantId        Int          @map("tenant_id")
  /// ID phòng được quét ảnh
  roomId          Int          @map("room_id")
  /// ID đồng hồ được quét ảnh
  meterId         Int          @map("meter_id")
  /// ID tài khoản người dùng tải ảnh lên xử lý
  uploadedBy      Int          @map("uploaded_by")
  /// Đường dẫn hình ảnh đầu vào tải lên để OCR nhận diện
  imageUrl        String       @map("image_url") @db.Text
  /// Public ID của ảnh trên Cloudinary để quản lý vòng đời asset
  imagePublicId   String?      @map("image_public_id") @db.VarChar(255)
  /// SHA-256 nội dung ảnh để chống tạo tác vụ trùng
  fileHash        String?      @map("file_hash") @db.VarChar(64)
  /// Giá trị số chỉ số đồng hồ mà AI nhận diện được (null nếu xử lý thất bại)
  recognizedValue Decimal?     @map("recognized_value") @db.Decimal(12, 2)
  /// Độ tin cậy tính toán của kết quả nhận diện từ AI (giá trị từ 0.00 đến 1.00)
  confidence      Decimal?     @db.Decimal(5, 4)
  /// Dữ liệu thô JSON trả về từ API AI phục vụ debug và lưu vết
  rawResult       Json?        @map("raw_result") @db.JsonB
  /// Trạng thái xử lý của tác vụ OCR
  status          OcrJobStatus @default(PENDING)
  /// Thông báo chi tiết lỗi hệ thống gặp phải khi xử lý (nếu có)
  errorMessage    String?      @map("error_message") @db.Text
  /// Thời điểm gửi tác vụ OCR lên hệ thống
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm hệ thống hoàn thành xử lý nhận diện AI
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Đồng hồ tương ứng (xóa đồng hồ thì cascade xóa tác vụ OCR liên quan)
  meter          UtilityMeter  @relation(fields: [meterId], references: [id], onDelete: Cascade)
  /// Người dùng tải ảnh lên (chặn xóa người dùng này nếu có job OCR)
  uploadedByUser User          @relation("UploadedJobs", fields: [uploadedBy], references: [id], onDelete: Restrict)
  /// Chỉ số điện nước được tạo sau khi người dùng duyệt kết quả
  reading        MeterReading?

  @@unique([tenantId, meterId, fileHash])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([meterId, createdAt])
  @@map("ocr_jobs")
}

/// Bảng quản lý các đợt phát hành hóa đơn tiền phòng hàng loạt hằng tháng của chủ trọ
model InvoiceBatch {
  /// ID đợt hóa đơn (UUID)
  id            Int                @id @default(autoincrement())
  /// ID Tenant phát hành
  tenantId      Int                @map("tenant_id")
  /// Tháng/năm lập hóa đơn thanh toán cho đợt này (ngày 1 của tháng tính toán)
  billingMonth  DateTime           @map("billing_month") @db.Date
  // (removed old createdBy)
  /// Trạng thái xử lý tạo hóa đơn hàng loạt
  status        InvoiceBatchStatus @default(DRAFT)
  /// Tổng số lượng hóa đơn được sinh ra trong đợt này
  totalInvoices Int                @default(0) @map("total_invoices")
  /// Thời điểm khởi tạo đợt phát hành hóa đơn
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant phát hành
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // (removed old createdByUser)
  /// Danh sách các hóa đơn chi tiết được sinh ra trực thuộc đợt này
  invoices Invoice[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("InvoiceBatchCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("InvoiceBatchUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("InvoiceBatchDeleter", fields: [deletedById], references: [id])

  @@unique([tenantId, billingMonth]) // Đảm bảo mỗi tenant chỉ tạo tối đa 1 đợt hóa đơn hàng loạt trong 1 tháng
  @@map("invoice_batches")
}

/// Danh mục phí dịch vụ dùng lại trong một tenant.
model ServiceCatalogItem {
  id               Int             @id @default(autoincrement())
  tenantId         Int             @map("tenant_id")
  code             String          @db.VarChar(50)
  name             String          @db.VarChar(255)
  description      String?         @db.Text
  itemType         InvoiceItemType @default(SERVICE) @map("item_type")
  defaultUnitPrice Decimal         @map("default_unit_price") @db.Decimal(12, 2)
  unitLabel        String          @default("tháng") @map("unit_label") @db.VarChar(50)
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments ServiceAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("service_catalog_items")
}

/// Phí định kỳ gán cho đúng một phòng hoặc một hợp đồng.
model ServiceAssignment {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  serviceItemId Int       @map("service_item_id")
  roomId        Int?      @map("room_id")
  contractId    Int?      @map("contract_id")
  quantity      Decimal   @default(1) @db.Decimal(12, 2)
  unitPrice     Decimal?  @map("unit_price") @db.Decimal(12, 2)
  startsAt      DateTime? @map("starts_at") @db.Date
  endsAt        DateTime? @map("ends_at") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceItem ServiceCatalogItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  room        Room?              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  contract    Contract?          @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([serviceItemId])
  @@index([roomId, isActive])
  @@index([contractId, isActive])
  @@map("service_assignments")
}

/// Bảng lưu trữ thông tin hóa đơn thu tiền phòng, điện nước và dịch vụ hằng tháng
model Invoice {
  /// ID hóa đơn (UUID)
  id             Int           @id @default(autoincrement())
  /// ID Tenant quản lý
  tenantId       Int           @map("tenant_id")
  /// ID đợt hóa đơn hàng loạt (nếu được tạo hàng loạt, null nếu tạo đơn lẻ)
  batchId        Int?          @map("batch_id")
  /// ID hợp đồng thuê phòng hiệu lực tại thời điểm xuất hóa đơn
  contractId     Int           @map("contract_id")
  /// ID phòng tính tiền
  roomId         Int           @map("room_id")
  /// ID tài khoản khách thuê chính chịu trách nhiệm thanh toán hóa đơn
  renterId       Int           @map("renter_id")
  /// Mã số hóa đơn duy nhất phục vụ đối chiếu thanh toán và tìm kiếm
  invoiceCode    String        @unique @map("invoice_code") @db.VarChar(100)
  /// Tháng tính toán tiền phòng (ngày 1 của tháng tính toán)
  billingMonth   DateTime      @map("billing_month") @db.Date
  /// Ngày phát hành hóa đơn chính thức gửi cho khách thuê
  issueDate      DateTime      @map("issue_date") @db.Date
  /// Ngày hạn chót khách thuê phải hoàn thành thanh toán hóa đơn
  dueDate        DateTime      @map("due_date") @db.Date
  /// Tổng tiền tạm tính trước thuế, phạt và chiết khấu giảm giá
  subtotal       Decimal       @db.Decimal(12, 2)
  /// Số tiền giảm giá hoặc chiết khấu ưu đãi áp dụng
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  /// Số tiền phí phạt chậm nộp tiền hoặc vi phạm cộng thêm
  penaltyAmount  Decimal       @default(0.00) @map("penalty_amount") @db.Decimal(12, 2)
  /// Tổng số tiền thực tế khách thuê cần phải thanh toán (Tạm tính + Phạt - Giảm giá)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  /// Số tiền lũy kế thực tế khách thuê đã thanh toán thành công cho hóa đơn này
  paidAmount     Decimal       @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  /// Số tiền còn nợ lại cần thanh toán tiếp (Tổng tiền - Đã thanh toán)
  debtAmount     Decimal       @map("debt_amount") @db.Decimal(12, 2)
  /// Trạng thái thanh toán của hóa đơn
  status         InvoiceStatus @default(UNPAID)
  /// Ghi chú hoặc lời nhắn gửi thêm cho người thuê trên hóa đơn
  note           String?       @db.Text
  /// Thời điểm khởi tạo hóa đơn
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật hóa đơn gần nhất
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm xóa hóa đơn (hỗ trợ xóa mềm)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Đợt hóa đơn hàng loạt liên quan (xóa đợt hóa đơn thì gỡ liên kết trong hóa đơn này)
  batch       InvoiceBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// Hợp đồng thuê phòng liên quan (chặn xóa hợp đồng nếu có hóa đơn phát sinh)
  contract    Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// Phòng trọ liên quan (chặn xóa phòng nếu có hóa đơn)
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// Khách thuê nhận hóa đơn (chặn xóa tài khoản người dùng nhận hóa đơn)
  renter      User                @relation("RenterInvoices", fields: [renterId], references: [id], onDelete: Restrict)
  /// Chi tiết các dòng khoản thu cấu thành nên hóa đơn này
  items       InvoiceItem[]
  /// Lịch sử các lần thực hiện giao dịch thanh toán của khách thuê cho hóa đơn này
  payments    Payment[]
  /// Danh sách các mã QR VietQR động đã sinh để thanh toán hóa đơn này
  qrCodes     PaymentQrCode[]
  /// Danh sách log webhook lịch sử nhận thanh toán liên quan đến hóa đơn này
  webhookLogs PaymentWebhookLog[]
  /// Bản ghi công nợ tương ứng với hóa đơn này
  debt        Debt?

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("InvoiceCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("InvoiceUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("InvoiceDeleter", fields: [deletedById], references: [id])

  @@index([tenantId, billingMonth])
  @@index([invoiceCode])
  @@index([status])
  @@map("invoices")
}

/// Bảng chi tiết các khoản phí cấu thành trong một hóa đơn hằng tháng (ví dụ: tiền điện, tiền phòng...)
model InvoiceItem {
  /// ID dòng chi tiết hóa đơn (UUID)
  id             Int             @id @default(autoincrement())
  /// ID hóa đơn chứa chi tiết này
  invoiceId      Int             @map("invoice_id")
  /// Phân loại danh mục khoản thu phí
  itemType       InvoiceItemType
  /// Ghi chú mô tả chi tiết khoản thu (ví dụ: Tiền điện chỉ số 1200 - 1350)
  description    String          @db.Text
  /// Số lượng tiêu thụ (ví dụ: số tháng thuê, số chữ điện tiêu thụ)
  quantity       Decimal         @db.Decimal(12, 2)
  /// Đơn giá áp dụng cho mỗi đơn vị số lượng
  unitPrice      Decimal         @map("unit_price") @db.Decimal(12, 2)
  /// Tổng tiền của dòng chi tiết này (Số lượng * Đơn giá)
  amount         Decimal         @db.Decimal(12, 2)
  /// ID chỉ số điện nước liên quan (nullable nếu khoản thu không phải điện nước tiêu thụ)
  meterReadingId Int?            @map("meter_reading_id")
  /// Thời điểm tạo chi tiết hóa đơn
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Hóa đơn chứa chi tiết này (xóa hóa đơn thì cascade xóa các dòng chi tiết)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Bản ghi chỉ số điện nước tương ứng làm căn cứ (gỡ liên kết chỉ số nếu bản ghi chỉ số bị xóa)
  meterReading MeterReading? @relation(fields: [meterReadingId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

/// Bảng ghi nhận công nợ phát sinh từ hóa đơn thuê phòng hằng tháng
model Debt {
  /// ID công nợ
  id              Int        @id @default(autoincrement())
  /// ID Tenant quản lý công nợ
  tenantId        Int        @map("tenant_id")
  /// ID hóa đơn phát sinh công nợ; mỗi hóa đơn chỉ có một bản ghi công nợ
  invoiceId       Int        @unique @map("invoice_id")
  /// ID hợp đồng liên quan
  contractId      Int        @map("contract_id")
  /// ID phòng phát sinh công nợ
  roomId          Int        @map("room_id")
  /// ID khách thuê chịu trách nhiệm thanh toán
  renterId        Int        @map("renter_id")
  /// Tháng ghi nhận công nợ
  billingMonth    DateTime   @map("billing_month") @db.Date
  /// Tổng số tiền ban đầu cần thu từ hóa đơn
  originalAmount  Decimal    @map("original_amount") @db.Decimal(12, 2)
  /// Số tiền đã thanh toán thành công
  paidAmount      Decimal    @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  /// Số tiền còn nợ
  remainingAmount Decimal    @map("remaining_amount") @db.Decimal(12, 2)
  /// Trạng thái công nợ hiện tại
  status          DebtStatus @default(OPEN)
  /// Ngày đến hạn thanh toán
  dueDate         DateTime   @map("due_date") @db.Date
  /// Thời điểm công nợ được tất toán hoặc hủy
  resolvedAt      DateTime?  @map("resolved_at") @db.Timestamptz
  /// Thời điểm tạo bản ghi công nợ
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật công nợ gần nhất
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant sở hữu công nợ
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Hóa đơn nguồn của công nợ
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Hợp đồng liên quan đến công nợ
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// Phòng phát sinh công nợ
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// Khách thuê chịu trách nhiệm thanh toán công nợ
  renter   User     @relation("RenterDebts", fields: [renterId], references: [id], onDelete: Restrict)

  @@index([tenantId, billingMonth])
  @@index([tenantId, status])
  @@index([renterId, status])
  @@map("debts")
}

/// Bảng ghi nhận các giao dịch thanh toán thực tế của khách thuê cho từng hóa đơn
model Payment {
  /// ID giao dịch thanh toán (UUID)
  id              Int           @id @default(autoincrement())
  /// ID Tenant quản lý nhận tiền
  tenantId        Int           @map("tenant_id")
  /// ID hóa đơn được thanh toán
  invoiceId       Int           @map("invoice_id")
  /// ID tài khoản người dùng thực hiện giao dịch thanh toán tiền
  payerId         Int           @map("payer_id")
  /// ID mã QR PayOS/VietQR liên quan đến giao dịch nếu có
  qrCodeId        Int?          @map("qr_code_id")
  /// Số tiền thực tế khách thực hiện thanh toán trong giao dịch này
  amount          Decimal       @db.Decimal(12, 2)
  /// Phương thức thanh toán (Tiền mặt, Chuyển khoản, Quét QR...)
  method          PaymentMethod @default(BANK_TRANSFER)
  /// Tên nhà cung cấp cổng hoặc ngân hàng xử lý thanh toán (ví dụ: VietQR, VNPay)
  provider        String?       @db.VarChar(100)
  /// Mã tham chiếu giao dịch duy nhất từ ngân hàng hoặc cổng thanh toán phục vụ đối soát
  transactionCode String?       @map("transaction_code") @db.VarChar(100)
  /// Trạng thái xử lý của giao dịch thanh toán
  status          PaymentStatus @default(PENDING)
  /// Thời điểm giao dịch được ghi nhận thanh toán thành công (null nếu chưa thành công)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz
  /// Thời điểm người thuê gửi xác nhận thanh toán
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamptz
  /// Đường dẫn minh chứng thanh toán do người thuê gửi
  evidenceUrl     String?       @map("evidence_url") @db.Text
  /// Ghi chú người thuê gửi kèm xác nhận thanh toán
  renterNote      String?       @map("renter_note") @db.Text
  /// ID người dùng duyệt thanh toán
  approvedById    Int?          @map("approved_by_id")
  /// Thời điểm chủ trọ/nhân viên duyệt thanh toán
  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz
  /// ID người dùng từ chối thanh toán
  rejectedById    Int?          @map("rejected_by_id")
  /// Thời điểm chủ trọ/nhân viên từ chối thanh toán
  rejectedAt      DateTime?     @map("rejected_at") @db.Timestamptz
  /// Ghi chú đối soát của chủ trọ/nhân viên
  landlordNote    String?       @map("landlord_note") @db.Text
  /// Thời điểm tạo yêu cầu giao dịch thanh toán
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật giao dịch thanh toán gần nhất
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant nhận tiền
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Hóa đơn tương ứng được thanh toán (xóa hóa đơn thì cascade xóa giao dịch)
  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Tài khoản người thanh toán (chặn xóa người dùng này nếu đã phát sinh thanh toán)
  payer      User           @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Restrict)
  /// Mã QR liên quan đến giao dịch thanh toán
  qrCode     PaymentQrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  /// Người duyệt thanh toán sau đối soát
  approvedBy User?          @relation("PaymentApprover", fields: [approvedById], references: [id])
  /// Người từ chối thanh toán sau đối soát
  rejectedBy User?          @relation("PaymentRejecter", fields: [rejectedById], references: [id])

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("PaymentCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("PaymentUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("PaymentDeleter", fields: [deletedById], references: [id])

  @@unique([provider, transactionCode], map: "payments_provider_transaction_code_key")
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, paidAt])
  @@index([invoiceId, status])
  @@index([qrCodeId])
  @@index([transactionCode])
  @@index([status])
  @@map("payments")
}

/// Bảng lưu trữ thông tin mã VietQR động được tạo phục vụ khách quét thanh toán hóa đơn tiện lợi
model PaymentQrCode {
  /// ID mã QR (UUID)
  id             Int          @id @default(autoincrement())
  /// ID Tenant quản lý
  tenantId       Int          @map("tenant_id")
  /// ID hóa đơn liên quan tạo mã QR
  invoiceId      Int          @map("invoice_id")
  /// Tên nhà cung cấp dịch vụ QR (ví dụ: VietQR, PayOS, MoMo)
  provider       String       @db.VarChar(100)
  /// Mã đơn hàng PayOS dùng để tạo payment link và đối soát webhook
  orderCode      Int?         @unique @default(dbgenerated("nextval('payos_order_code_seq'::regclass)")) @map("order_code")
  /// ID payment link do PayOS trả về
  paymentLinkId  String?      @unique @map("payment_link_id") @db.VarChar(100)
  /// Nội dung chuỗi text thô mã hóa trong mã QR phục vụ quét
  qrContent      String?      @map("qr_content") @db.Text
  /// Đường dẫn hình ảnh hiển thị mã QR được sinh động
  qrImageUrl     String?      @map("qr_image_url") @db.Text
  /// URL checkout do PayOS trả về
  checkoutUrl    String?      @map("checkout_url") @db.Text
  /// Số tiền thanh toán mã hóa trong QR bao gồm cả phí phạt/lẻ nếu có
  amount         Decimal      @db.Decimal(12, 2)
  /// Trạng thái payment link theo nhà cung cấp
  providerStatus String?      @map("provider_status") @db.VarChar(50)
  /// Thời điểm mã QR động này hết hạn hiệu lực quét thanh toán
  expiredAt      DateTime     @map("expired_at") @db.Timestamptz
  /// Trạng thái hoạt động của mã QR
  status         QrCodeStatus @default(ACTIVE)
  /// Thời điểm sinh mã QR
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật mã QR gần nhất
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Hóa đơn liên quan (xóa hóa đơn thì cascade xóa mã QR động kèm theo)
  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Danh sách thanh toán liên quan đến mã QR này
  payments Payment[]

  @@index([orderCode])
  @@index([paymentLinkId])
  @@map("payment_qr_codes")
}

/// Bảng ghi nhận lịch sử các gói tin Webhook gọi từ cổng thanh toán tự động đến hệ thống
model PaymentWebhookLog {
  /// ID log webhook (UUID)
  id                    Int              @id @default(autoincrement())
  /// Tên cổng thanh toán gửi webhook (ví dụ: PayOS, VNPay, MoMo)
  provider              String           @db.VarChar(100)
  /// ID Tenant liên quan (mới nhận có thể null, sau đó phân tích payload để ánh xạ)
  tenantId              Int?             @map("tenant_id")
  /// ID hóa đơn liên quan (mới nhận có thể null, sau đó phân tích payload để ánh xạ)
  invoiceId             Int?             @map("invoice_id")
  /// ID giao dịch subscription payment liên quan
  subscriptionPaymentId Int?             @map("subscription_payment_id")
  /// Mã đơn hàng PayOS trong payload webhook
  orderCode             Int?             @map("order_code")
  /// ID payment link PayOS trong payload webhook
  paymentLinkId         String?          @map("payment_link_id") @db.VarChar(100)
  /// Mã tham chiếu giao dịch ngân hàng trong payload PayOS
  reference             String?          @db.VarChar(100)
  /// Mã giao dịch tham chiếu của cổng thanh toán gửi trong webhook
  transactionCode       String?          @map("transaction_code") @db.VarChar(100)
  /// Số tiền thanh toán trong payload PayOS
  amount                Decimal?         @db.Decimal(12, 2)
  /// Đơn vị tiền tệ trong payload PayOS
  currency              String?          @db.VarChar(10)
  /// Mã trạng thái PayOS trong phần data
  providerCode          String?          @map("provider_code") @db.VarChar(20)
  /// Mô tả trạng thái PayOS trong phần data
  providerDesc          String?          @map("provider_desc") @db.Text
  /// Cờ thành công từ payload PayOS
  success               Boolean?
  /// Thời điểm giao dịch theo payload PayOS
  transactionDateTime   DateTime?        @map("transaction_date_time") @db.Timestamptz
  /// Dữ liệu thô dạng JSON nhận được từ cổng thanh toán để lưu vết đối soát
  payload               Json             @db.JsonB
  /// HMAC-SHA256 của payload gốc trước khi loại bỏ dữ liệu nhạy cảm
  payloadDigest         String?          @map("payload_digest") @db.VarChar(64)
  /// Phiên bản khóa HMAC dùng để tạo digest
  digestKeyVersion      Int?             @map("digest_key_version")
  /// Đánh dấu chữ ký bảo mật webhook có hợp lệ không
  signatureValid        Boolean          @default(false) @map("signature_valid")
  /// Trạng thái xử lý gói tin webhook của hệ thống
  status                WebhookLogStatus @default(RECEIVED)
  /// Chi tiết thông báo lỗi trong quá trình phân tích và xử lý tự động webhook (nếu có)
  errorMessage          String?          @map("error_message") @db.Text
  /// Thời điểm hệ thống nhận được request webhook này
  receivedAt            DateTime         @default(now()) @map("received_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant liên kết (nếu có, xóa tenant thì cascade xóa webhook log)
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Hóa đơn liên quan (nếu có, xóa hóa đơn thì gỡ liên kết trong webhook log này để đối soát độc lập)
  invoice             Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// Subscription payment liên quan (nếu có)
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)

  @@index([orderCode])
  @@index([paymentLinkId])
  @@index([reference])
  @@index([provider, reference])
  @@index([tenantId, status])
  @@index([subscriptionPaymentId])
  @@index([receivedAt, id])
  @@map("payment_webhook_logs")
}

/// Bảng quản lý các yêu cầu báo cáo sự cố, yêu cầu sửa chữa cơ sở vật chất (Ticket)
model Ticket {
  /// ID ticket (UUID)
  id          Int            @id @default(autoincrement())
  /// ID Tenant quản lý phòng trọ
  tenantId    Int            @map("tenant_id")
  /// ID phòng trọ xảy ra sự cố cần sửa chữa
  roomId      Int            @map("room_id")
  /// ID hợp đồng thuê phòng liên quan tại thời điểm xảy ra sự cố (nullable nếu phòng trống)
  contractId  Int?           @map("contract_id")
  // (removed old createdBy)
  /// ID nhân viên được phân công xử lý sự cố (nullable nếu chưa phân công)
  assignedTo  Int?           @map("assigned_to")
  /// Tiêu đề báo cáo ngắn gọn (ví dụ: Hỏng vòi nước nhà vệ sinh)
  title       String         @db.VarChar(255)
  /// Mô tả chi tiết về hiện trạng sự cố xảy ra
  description String         @db.Text
  /// Nhóm phân loại sự cố (Điện, Nước, Mạng internet...)
  category    TicketCategory
  /// Mức độ ưu tiên xử lý sự cố
  priority    TicketPriority @default(MEDIUM)
  /// Trạng thái tiến độ giải quyết sự cố
  status      TicketStatus   @default(OPEN)
  /// Thời điểm gửi yêu cầu báo cáo sự cố
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật tiến độ ticket gần nhất
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm hoàn tất giải quyết sự cố
  resolvedAt  DateTime?      @map("resolved_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý phòng trọ (xóa tenant thì cascade xóa các ticket)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ xảy ra sự cố (xóa phòng thì cascade xóa ticket của phòng đó)
  room           Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Hợp đồng thuê phòng liên quan (gỡ liên kết nếu hợp đồng bị xóa)
  contract       Contract?          @relation(fields: [contractId], references: [id], onDelete: SetNull)
  // (removed old createdByUser)
  /// Nhân viên được phân công xử lý (gỡ liên kết nếu tài khoản nhân viên bị xóa)
  assignedToUser User?              @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  /// Danh sách hình ảnh, video hiện trạng sự cố đính kèm
  attachments    TicketAttachment[]
  /// Các bình luận trao đổi thảo luận giải quyết sự cố
  comments       TicketComment[]
  /// Phòng chat trực tiếp để bàn luận về ticket này
  conversations  Conversation[]

  /// ID người dùng tạo bản ghi
  createdById Int? @map("created_by_id")
  /// ID người dùng cập nhật bản ghi gần nhất
  updatedById Int? @map("updated_by_id")
  /// ID người dùng thực hiện xóa mềm bản ghi
  deletedById Int? @map("deleted_by_id")

  createdBy User? @relation("TicketCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("TicketUpdater", fields: [updatedById], references: [id])
  deletedBy User? @relation("TicketDeleter", fields: [deletedById], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([createdById, status])
  @@map("tickets")
}

/// Bảng lưu các file hình ảnh/video hiện trạng đính kèm khi báo cáo sự cố
model TicketAttachment {
  /// ID file đính kèm (UUID)
  id         Int      @id @default(autoincrement())
  /// ID ticket liên quan
  ticketId   Int      @map("ticket_id")
  /// Đường dẫn lưu trữ hình ảnh/video sự cố
  fileUrl    String   @map("file_url") @db.Text
  /// Public identifier used to manage the uploaded Cloudinary asset
  publicId   String?  @map("public_id") @db.VarChar(255)
  /// Loại file (ví dụ: image, video, document)
  fileType   String   @map("file_type") @db.VarChar(50)
  /// ID tài khoản người dùng tải file lên làm bằng chứng
  uploadedBy Int      @map("uploaded_by")
  /// Thời điểm tải file lên
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Ticket sự cố tương ứng (xóa ticket thì cascade xóa file đính kèm)
  ticket         Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Người dùng tải file lên (xóa người dùng thì cascade xóa file đính kèm của họ)
  uploadedByUser User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt, id])
  @@map("ticket_attachments")
}

/// Bảng lưu trữ cấu hình tùy biến toàn hệ thống động (System Settings) dạng Key-Value
model SystemSetting {
  /// ID cấu hình (UUID)
  id          Int      @id @default(autoincrement())
  /// Mã định danh tham chiếu duy nhất của cấu hình (ví dụ: min_deposit_months)
  key         String   @unique @db.VarChar(100)
  /// Giá trị thiết lập lưu dạng JSON (linh hoạt cho cả String, Number, Array, Object)
  value       Json     @db.JsonB
  /// Mô tả chức năng và ý nghĩa của khóa cấu hình này
  description String?  @db.Text
  /// Thời điểm cập nhật giá trị cấu hình gần nhất
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

/// Bảng lưu trữ trao đổi, thảo luận chi tiết giữa khách thuê và chủ trọ về việc xử lý sự cố
model TicketComment {
  /// ID bình luận (UUID)
  id         Int      @id @default(autoincrement())
  /// ID ticket sự cố liên quan
  ticketId   Int      @map("ticket_id")
  /// ID tài khoản người gửi bình luận (khách thuê hoặc chủ trọ/nhân viên)
  userId     Int      @map("user_id")
  /// Nội dung tin nhắn trao đổi trong ticket
  message    String   @db.Text
  /// Đánh dấu bình luận nội bộ chỉ nhân viên và chủ trọ thấy (ẩn với khách thuê)
  isInternal Boolean  @default(false) @map("is_internal")
  /// Thời điểm gửi bình luận
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Ticket sự cố tương ứng (xóa ticket thì cascade xóa các bình luận)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Người gửi bình luận (chặn xóa người dùng để bảo lưu lịch sử chat của hệ thống)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([ticketId, isInternal, createdAt, id])
  @@map("ticket_comments")
}

/// Bảng lưu thông tin các phòng chat giao tiếp trong hệ thống
model Conversation {
  /// ID phòng chat (UUID)
  id         Int              @id @default(autoincrement())
  /// ID Tenant quản lý phòng chat này
  tenantId   Int              @map("tenant_id")
  /// ID phòng trọ liên quan (nullable nếu chat hỗ trợ chung)
  roomId     Int?             @map("room_id")
  /// ID hợp đồng thuê phòng liên quan (nullable)
  contractId Int?             @map("contract_id")
  /// ID ticket sự cố liên quan (nullable)
  ticketId   Int?             @map("ticket_id")
  /// Phân loại mục đích phòng chat
  type       ConversationType
  /// Thời điểm khởi tạo cuộc trò chuyện chat
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant quản lý
  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ liên quan (gỡ liên kết nếu phòng bị xóa)
  room     Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Hợp đồng thuê phòng liên quan (gỡ liên kết nếu hợp đồng bị xóa)
  contract Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// Ticket sự cố liên quan (gỡ liên kết nếu ticket bị xóa)
  ticket   Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// Danh sách các thành viên tham gia trong phòng chat này
  members  ConversationMember[]
  /// Danh sách các tin nhắn gửi đi trong phòng chat này
  messages Message[]

  @@map("conversations")
}

/// Bảng trung gian quản lý thành viên tham gia trong phòng chat
model ConversationMember {
  /// ID phòng chat
  conversationId Int      @map("conversation_id")
  /// ID tài khoản người dùng tham gia chat
  userId         Int      @map("user_id")
  /// Thời điểm tham gia vào phòng chat
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Phòng chat tương ứng (xóa phòng chat thì cascade xóa thành viên liên kết)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Tài khoản người dùng (xóa người dùng thì cascade xóa liên kết phòng chat)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

/// Bảng ghi nhận các tin nhắn chi tiết trong các cuộc hội thoại chat
model Message {
  /// ID tin nhắn (UUID)
  id             Int         @id @default(autoincrement())
  /// ID phòng chat chứa tin nhắn này
  conversationId Int         @map("conversation_id")
  /// ID tài khoản người gửi tin nhắn
  senderId       Int         @map("sender_id")
  /// Nội dung tin nhắn chat (văn bản thô)
  content        String      @db.Text
  /// Loại tin nhắn (text, ảnh, file đính kèm hoặc thông báo hệ thống)
  messageType    MessageType @default(TEXT) @map("message_type")
  /// Đường dẫn file đính kèm trên cloud storage (nếu có)
  fileUrl        String?     @map("file_url") @db.Text
  /// Thời điểm người nhận tin nhắn đã đọc tin (null nếu chưa đọc)
  readAt         DateTime?   @map("read_at") @db.Timestamptz
  /// Thời điểm gửi tin nhắn
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm thu hồi/xóa tin nhắn (hỗ trợ xóa mềm)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Phòng chat chứa tin nhắn (xóa phòng chat thì cascade xóa toàn bộ tin nhắn)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Người gửi tin nhắn (chặn xóa người dùng để bảo lưu lịch sử chat của hệ thống)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@map("messages")
}

/// Bảng lưu trữ đánh giá phản hồi của khách thuê về chất lượng phòng và chủ trọ
model Review {
  /// ID đánh giá (UUID)
  id               Int          @id @default(autoincrement())
  /// ID Tenant sở hữu phòng được đánh giá
  tenantId         Int          @map("tenant_id")
  /// ID phòng trọ nhận đánh giá
  roomId           Int          @map("room_id")
  /// ID hợp đồng thuê liên quan làm căn cứ xác thực khách trọ
  contractId       Int          @map("contract_id")
  /// ID tài khoản khách thuê gửi đánh giá phản hồi
  reviewerId       Int          @map("reviewer_id")
  /// Điểm đánh giá chung tổng hợp (giá trị từ 1 đến 5 sao)
  rating           Int
  /// Nội dung nhận xét, đánh giá chi tiết
  content          String       @db.Text
  /// Điểm đánh giá chi tiết về vệ sinh của phòng trọ (1-5 sao)
  cleanlinessScore Int          @map("cleanliness_score")
  /// Điểm đánh giá chi tiết về vị trí địa lý của phòng trọ (1-5 sao)
  locationScore    Int          @map("location_score")
  /// Điểm đánh giá chi tiết về độ hợp lý của giá cả (1-5 sao)
  priceScore       Int          @map("price_score")
  /// Điểm đánh giá chi tiết về dịch vụ quản lý hỗ trợ (1-5 sao)
  serviceScore     Int          @map("service_score")
  /// Đánh dấu cho phép hiển thị công khai trên Marketplace tìm kiếm phòng
  isVisible        Boolean      @default(false) @map("is_visible")
  /// Trạng thái duyệt nội dung đánh giá phòng trọ
  status           ReviewStatus @default(PENDING)
  /// ID quản trị viên thực hiện kiểm duyệt gần nhất
  moderatedById    Int?         @map("moderated_by_id")
  /// Lý do kiểm duyệt gần nhất
  moderationReason String?      @map("moderation_reason") @db.Text
  /// Thời điểm kiểm duyệt gần nhất
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz
  /// Thời điểm gửi đánh giá
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật đánh giá gần nhất
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant liên quan (xóa tenant thì cascade xóa đánh giá)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ được đánh giá (xóa phòng thì cascade xóa các đánh giá liên quan)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Hợp đồng thuê phòng liên quan (gỡ liên kết nếu hợp đồng bị xóa)
  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// Tài khoản người đánh giá (chặn xóa tài khoản người đánh giá)
  reviewer  User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  /// Quản trị viên kiểm duyệt gần nhất
  moderator User?    @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([reviewerId, contractId])
  @@index([reviewerId, createdAt])
  @@index([status, createdAt])
  @@index([roomId, status, isVisible, createdAt])
  @@map("reviews")
}

/// Bảng tổng hợp điểm uy tín của chủ trọ (Tenant) hoặc phòng trọ cụ thể dựa trên đánh giá, hỗ trợ sự cố
model ReputationScore {
  /// ID bản ghi điểm uy tín (UUID)
  id                  Int                  @id @default(autoincrement())
  /// Phân loại đối tượng tính điểm là chủ trọ (Tenant) hay phòng cụ thể (Room)
  targetType          ReputationTargetType @map("target_type")
  /// ID Tenant liên quan
  tenantId            Int                  @map("tenant_id")
  /// ID phòng trọ liên quan (nullable nếu là điểm chung của Tenant)
  roomId              Int?                 @map("room_id")
  /// Điểm trung bình đánh giá từ khách thuê (0.00 đến 5.00)
  averageRating       Decimal              @map("average_rating") @db.Decimal(3, 2)
  /// Tổng số lượng đánh giá nhận được để tính trung bình
  totalReviews        Int                  @default(0) @map("total_reviews")
  /// Điểm đánh giá dựa trên tốc độ và hiệu quả xử lý ticket sự cố (0.00 đến 5.00)
  ticketResponseScore Decimal              @map("ticket_response_score") @db.Decimal(3, 2)
  /// Điểm đánh giá tính minh bạch chi phí hóa đơn phát sinh (0.00 đến 5.00)
  transparencyScore   Decimal              @map("transparency_score") @db.Decimal(3, 2)
  /// Điểm đánh giá dựa trên xác thực thông tin giấy tờ pháp lý (0.00 đến 5.00)
  verificationScore   Decimal              @map("verification_score") @db.Decimal(3, 2)
  /// Điểm uy tín tổng hợp cuối cùng sử dụng cho thuật toán hiển thị nổi bật trên Marketplace
  finalScore          Decimal              @map("final_score") @db.Decimal(3, 2)
  /// Thời điểm cập nhật điểm uy tín gần nhất
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant tương ứng
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Phòng trọ tương ứng (gỡ liên kết nếu phòng bị xóa)
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@map("reputation_scores")
}

/// Bảng báo cáo hành vi vi phạm hoặc thông tin sai lệch gửi lên Super Admin kiểm duyệt
model Report {
  /// ID báo cáo vi phạm (UUID)
  id             Int              @id @default(autoincrement())
  /// ID tài khoản người dùng gửi báo cáo vi phạm
  reporterId     Int              @map("reporter_id")
  /// Loại đối tượng bị báo cáo vi phạm (Phòng, Chủ trọ, Đánh giá, Người dùng)
  targetType     ReportTargetType @map("target_type")
  /// ID của đối tượng bị báo cáo (Lưu String dạng mã định danh)
  targetId       String           @map("target_id") @db.VarChar(50)
  /// Tenant liên quan đến đối tượng tại thời điểm báo cáo, nếu có
  targetTenantId Int?             @map("target_tenant_id")
  /// Bản chụp dữ liệu tối thiểu của đối tượng tại thời điểm báo cáo
  targetSnapshot Json             @map("target_snapshot") @db.JsonB
  /// Dấu vân tay chống tạo nhiều báo cáo đang mở cho cùng đối tượng
  fingerprint    String           @db.VarChar(64)
  /// Lý do báo cáo vi phạm (tiêu đề lý do)
  reason         String           @db.VarChar(255)
  /// Mô tả chi tiết hành vi vi phạm hoặc sai thông tin
  description    String?          @db.Text
  /// Trạng thái xử lý báo cáo vi phạm của Ban quản trị
  status         ReportStatus     @default(PENDING)
  /// ID tài khoản Super Admin thực hiện xử lý báo cáo (nullable nếu chưa xử lý)
  handledBy      Int?             @map("handled_by")
  /// Thời điểm quản trị viên nhận xử lý báo cáo
  reviewingAt    DateTime?        @map("reviewing_at") @db.Timestamptz
  /// Kết luận an toàn có thể hiển thị cho người gửi
  resolutionNote String?          @map("resolution_note") @db.Text
  /// Thời điểm gửi báo cáo vi phạm
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm Ban quản trị xử lý xong báo cáo
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz
  /// Thời điểm cập nhật báo cáo gần nhất
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Người dùng gửi báo cáo (chặn xóa người dùng để theo dõi hành vi báo cáo)
  reporter      User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  /// Admin xử lý báo cáo (gỡ liên kết nếu tài khoản admin bị xóa)
  handledByUser User? @relation("ReportHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([handledBy, status])
  @@map("reports")
}

/// Bảng lưu thông báo nội bộ hệ thống gửi cho người dùng
model Notification {
  /// ID thông báo (UUID)
  id        Int              @id @default(autoincrement())
  /// ID tài khoản nhận thông báo
  userId    Int              @map("user_id")
  /// ID Tenant liên quan gửi thông báo (nullable nếu là thông báo hệ thống toàn sàn)
  tenantId  Int?             @map("tenant_id")
  /// Tiêu đề thông báo ngắn gọn
  title     String           @db.VarChar(255)
  /// Nội dung chi tiết thông báo
  content   String           @db.Text
  /// Phân loại nhóm thông báo
  type      NotificationType
  /// Dữ liệu bổ sung tùy biến (lưu JSON phục vụ điều hướng chuyển trang trên app)
  data      Json?            @db.JsonB
  /// Đánh dấu khách thuê đã đọc thông báo chưa
  isRead    Boolean          @default(false) @map("is_read")
  /// Thời điểm người dùng nhấn đọc thông báo
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  /// Thời điểm tạo thông báo đẩy gửi đi
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Người dùng nhận thông báo (xóa người dùng thì cascade xóa thông báo tương ứng)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tenant liên quan gửi thông báo (xóa tenant thì cascade xóa thông báo)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Bảng lưu các mã token thiết bị di động/web phục vụ đẩy thông báo qua Firebase Cloud Messaging (FCM)
model DeviceToken {
  /// ID token (UUID)
  id           Int            @id @default(autoincrement())
  /// ID tài khoản người dùng sở hữu thiết bị này
  userId       Int            @map("user_id")
  /// Chuỗi token FCM duy nhất phục vụ push notification
  token        String         @db.Text
  /// Firebase Installation ID mới hơn registration token, dùng để hỗ trợ quản lý vòng đời token
  fid          String?        @db.VarChar(255)
  /// Hệ điều hành của thiết bị nhận thông báo (iOS, Android hoặc Web)
  platform     DevicePlatform
  /// Tên gọi nhận diện thiết bị vật lý (ví dụ: iPhone 14 Pro, Samsung S23)
  deviceName   String?        @map("device_name") @db.VarChar(100)
  /// Đánh dấu token thiết bị có đang hoạt động nhận tin không
  isActive     Boolean        @default(true) @map("is_active")
  /// Thời điểm client gần nhất gửi/refresh token này
  lastSeenAt   DateTime?      @map("last_seen_at") @db.Timestamptz
  /// Thời điểm backend gần nhất dùng token này để gửi push
  lastUsedAt   DateTime?      @map("last_used_at") @db.Timestamptz
  /// Số lần gửi lỗi liên tiếp để hỗ trợ quan sát token không ổn định
  failureCount Int            @default(0) @map("failure_count")
  /// Mã lỗi FCM gần nhất nếu có
  lastError    String?        @map("last_error") @db.Text
  /// Thời điểm token bị vô hiệu hóa do client xóa hoặc FCM báo invalid
  disabledAt   DateTime?      @map("disabled_at") @db.Timestamptz
  /// Thời điểm đăng ký token thiết bị
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật trạng thái hoạt động của token gần nhất
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Người dùng sở hữu thiết bị (xóa người dùng thì cascade xóa token thiết bị tương ứng)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token]) // Tránh lưu trùng lặp một token thiết bị nhiều lần cho cùng người dùng
  @@index([userId, isActive])
  @@index([fid])
  @@index([platform, isActive])
  @@map("device_tokens")
}

/// Bảng lưu trạng thái và thông tin của các tác vụ chạy ngầm (Background Jobs)
model BackgroundJob {
  /// ID tác vụ (UUID)
  id            Int                 @id @default(autoincrement())
  /// ID Tenant liên quan (nullable nếu là tác vụ hệ thống)
  tenantId      Int?                @map("tenant_id")
  /// Tên hàng đợi (ví dụ: default, email, invoices)
  queueName     String              @map("queue_name") @db.VarChar(100)
  /// ID job phía BullMQ để đối soát trạng thái retry/complete/fail
  externalJobId String?             @map("external_job_id") @db.VarChar(100)
  /// Phân loại loại tác vụ cần thực hiện (ví dụ: SEND_EMAIL_INVOICE)
  jobType       String              @map("job_type") @db.VarChar(100)
  /// Dữ liệu đầu vào cấu hình cho tác vụ dạng JSON
  payload       Json                @db.JsonB
  /// Trạng thái thực thi hiện tại của tác vụ
  status        BackgroundJobStatus @default(WAITING)
  /// Số lần thực thi thử lại khi gặp lỗi
  attempts      Int                 @default(0)
  /// Chi tiết thông báo lỗi khi tác vụ thất bại
  errorMessage  String?             @map("error_message") @db.Text
  /// Thời điểm đăng ký tạo tác vụ
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  /// Thời điểm cập nhật trạng thái job gần nhất
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  /// Thời điểm bắt đầu xử lý tác vụ
  processedAt   DateTime?           @map("processed_at") @db.Timestamptz
  /// Thời điểm tác vụ hoàn tất xử lý (hoặc thất bại hoàn toàn)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant liên quan (xóa tenant thì cascade xóa các job nền)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([externalJobId])
  @@map("background_jobs")
}

/// Bảng ghi nhận nhật ký kiểm toán (Audit Logs) để giám sát và lưu vết các thao tác dữ liệu nhạy cảm
model AuditLog {
  /// ID bản ghi log (UUID)
  id         Int      @id @default(autoincrement())
  /// ID Tenant xảy ra thao tác dữ liệu (nullable nếu là thao tác hệ thống)
  tenantId   Int?     @map("tenant_id")
  /// ID tài khoản người dùng thực hiện thao tác (nullable nếu do hệ thống chạy tự động)
  actorId    Int?     @map("actor_id")
  /// Hành động thực hiện (ví dụ: CREATE_INVOICE, UPDATE_ROOM_PRICE)
  action     String   @db.VarChar(100)
  /// Phân loại loại thực thể bị tác động (ví dụ: ROOM, CONTRACT, INVOICE)
  entityType String   @map("entity_type") @db.VarChar(100)
  /// ID của thực thể bị tác động
  entityId   String   @map("entity_id") @db.VarChar(50)
  /// Giá trị dữ liệu cũ trước khi thao tác dạng JSON
  oldValues  Json?    @map("old_values") @db.JsonB
  /// Giá trị dữ liệu mới sau khi thao tác dạng JSON
  newValues  Json?    @map("new_values") @db.JsonB
  /// Địa chỉ IP của máy khách hàng thực hiện thao tác
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  /// Thông tin trình duyệt và thiết bị của khách hàng
  userAgent  String?  @map("user_agent") @db.Text
  /// Thời điểm thực hiện hành động thao tác dữ liệu
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Các quan hệ (Relations)
  /// Tenant liên đới (xóa tenant thì cascade xóa audit logs)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Người thực hiện (gỡ liên kết nếu tài khoản người thực hiện bị xóa để giữ lại vết)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

