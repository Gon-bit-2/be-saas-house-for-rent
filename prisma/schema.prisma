  /// Phòng chat phục vụ trao đổi sửa chữa sự cố của ticket
  TICKET_CHAT
  /// Phòng chat hỗ trợ chung giữa khách thuê và Super Admin / Chủ trọ
  SUPPORT_CHAT
}

/// Phân loại loại tin nhắn
enum MessageType {
  /// Tin nhắn văn bản thuần túy
  TEXT
  /// Tin nhắn kèm hình ảnh chụp
  IMAGE
  /// Tin nhắn đính kèm file tài liệu
  FILE
  /// Tin nhắn hệ thống (ví dụ: Thông báo bắt đầu cuộc trò chuyện)
  SYSTEM
}

/// Trạng thái kiểm duyệt đánh giá phòng trọ
enum ReviewStatus {
  /// Đang chờ quản trị viên duyệt hiển thị
  PENDING
  /// Đã duyệt hiển thị công khai trên Marketplace
  APPROVED
  /// Từ chối hiển thị đánh giá do vi phạm quy định
  REJECTED
  /// Đã bị ẩn bởi quản trị viên
  HIDDEN
}

/// Loại đối tượng tính điểm uy tín
enum ReputationTargetType {
  /// Điểm uy tín của chủ trọ/tổ chức (Tenant)
  TENANT
  /// Điểm uy tín của phòng trọ cụ thể
  ROOM
}

/// Phân loại đối tượng bị báo cáo vi phạm
enum ReportTargetType {
  /// Báo cáo vi phạm tin đăng phòng trọ
  ROOM
  /// Báo cáo vi phạm hành vi của chủ trọ
  TENANT
  /// Báo cáo vi phạm nội dung đánh giá sai sự thật
  REVIEW
  /// Báo cáo vi phạm hành vi của người dùng khác
  USER
}

/// Trạng thái xử lý báo cáo vi phạm
enum ReportStatus {
  /// Báo cáo mới nhận, đang chờ xử lý
  PENDING
  /// Đang được Admin/Super Admin kiểm tra xác minh
  REVIEWING
  /// Báo cáo đã xử lý xong (đã ẩn đối tượng vi phạm hoặc cảnh cáo)
  RESOLVED
  /// Báo cáo bị từ chối do không vi phạm hoặc thiếu bằng chứng
  REJECTED
}

/// Phân loại danh mục thông báo hệ thống gửi
enum NotificationType {
  /// Thông báo liên quan đến phát hành hóa đơn mới
  INVOICE
  /// Thông báo liên quan đến thanh toán tiền phòng thành công hoặc thất bại
  PAYMENT
  /// Thông báo liên quan đến ký hợp đồng, trả phòng
  CONTRACT
  /// Thông báo cập nhật tiến độ xử lý ticket sự cố
  TICKET
  /// Thông báo nhắc lịch hẹn xem phòng trọ
  APPOINTMENT
  /// Thông báo liên quan đến đánh giá phòng
  REVIEW
  /// Thông báo liên quan đến báo cáo vi phạm
  REPORT
  /// Thông báo kiểm duyệt tin đăng marketplace
  MARKETPLACE
  /// Thông báo liên quan đến yêu cầu thuê phòng
  RENTAL_REQUEST
  /// Thông báo chung hoặc cập nhật từ hệ thống SaaS
  SYSTEM
}

/// Nền tảng thiết bị di động/web nhận thông báo đẩy
enum DevicePlatform {
  /// Điện thoại hệ điều hành iOS
  IOS
  /// Điện thoại hệ điều hành Android
  ANDROID
  /// Trình duyệt web
  WEB
}

/// Trạng thái của tác vụ chạy ngầm
enum BackgroundJobStatus {
  /// Đang chờ đến lượt xử lý
  WAITING
  /// Tác vụ đang được thực thi
  ACTIVE
  /// Tác vụ đã hoàn thành thành công
  COMPLETED
  /// Tác vụ thất bại sau các lượt thử
  FAILED
  /// Tác vụ lỗi và đang chờ chạy lại
  RETRYING
}
