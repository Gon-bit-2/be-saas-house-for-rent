{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "payos": "npx cloudflared tunnel --url http://localhost:1174",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status --schema prisma/schema.prisma",
    "test-accounts:create": "npm run build && node dist/inittalScripts/create-test-users.js",
    "test-accounts:prepare-api": "npm run build && node dist/inittalScripts/prepare-api-test-accounts.js",
    "security:preflight-webhook-logs": "ts-node -r tsconfig-paths/register inittalScripts/sanitize-payment-webhook-logs.ts",
    "security:sanitize-webhook-logs": "ts-node -r tsconfig-paths/register inittalScripts/sanitize-payment-webhook-logs.ts --apply",
    "permission:sync": "node dist/inittalScripts/create-permission.js",
    "openapi:export": "npm run build && node dist/inittalScripts/export-openapi.js",
    "docs:check": "npm run build && node dist/inittalScripts/check-docs.js",
    "contract:generate": "npm run openapi:export",
    "contract:check": "npm run build && node dist/inittalScripts/check-contract.js",
    "contract:compat": "npm run build && node dist/inittalScripts/check-openapi-compatibility.js",
    "e2e:up": "docker compose -f compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -f compose.e2e.yml down -v",
    "test:e2e:acceptance": "node inittalScripts/run-acceptance-e2e.cjs"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.7",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "latest",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "latest",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@payos/node": "^2.0.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/multer": "^2.2.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.5",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^@src/(.*)$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1",
      "^generated/(.*)$": "<rootDir>/../generated/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
